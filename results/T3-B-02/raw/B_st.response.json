     "type": "output_text",
     "text": "FUNCTION_BLOCK TankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_no : INT := 0;\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    FillTON : TON;\n    FillTOF : TOF;\nEND_VAR\n\n(* Timers are evaluated every scan using filling-step activity. *)\nfilling_active := (state_no = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\n\nFillTON(IN := filling_active, PT := TON_Duration);\nFillTOF(IN := filling_active, PT := TOF_Duration);\n\nton_q := FillTON.Q;\ntof_q := FillTOF.Q;\n\n(* Stop and both level switches take priority over sequence transitions. *)\nIF stop OR LSH OR LSHH THEN\n    state_no := 0;\nELSE\n    CASE state_no OF\n        0:\n            IF start THEN\n                state_no := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                state_no := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                state_no := 1;\n            END_IF;\n\n        ELSE\n            state_no := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (state_no = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable initial timer settings. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    StartEdge : R_TRIG;\n    Controller : TankControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
