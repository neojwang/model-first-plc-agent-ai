     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    FillTimer : TON;\n    CurrentState : INT := 0;\n    start : BOOL;\n    stop : BOOL;\n    timer_done : BOOL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nIF stop THEN\n    CurrentState := 0;\nELSE\n    CASE CurrentState OF\n        0:\n            IF start AND NOT LSHH THEN\n                CurrentState := 1;\n            END_IF;\n        1:\n            IF LSHH THEN\n                CurrentState := 0;\n            END_IF;\n    ELSE\n        CurrentState := 0;\n    END_CASE;\nEND_IF;\n\nFillTimer(IN := (CurrentState = 1), PT := TimerDuration);\ntimer_done := FillTimer.Q;\n\nIF timer_done THEN\n    CurrentState := 0;\n    (* Reset the timer so a new start can be accepted next scan. *)\n    FillTimer(IN := FALSE, PT := TimerDuration);\nEND_IF;\n\nfill_valve := (CurrentState = 1) AND NOT stop AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TimerDuration : TIME := T#10s;\n    Controller : FillingControl;\nEND_VAR\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
