     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    t1 : BOOL;\n    t2 : BOOL;\n    timer_done : BOOL := FALSE;\n    filling_timer : TON;\nEND_VAR\n\n(* Update the timer for the situation active at scan entry. *)\nfilling_timer(IN := x1, PT := TimerDuration);\ntimer_done := filling_timer.Q;\n\n(* Evaluate both transitions against the same situation. *)\nt1 := x0 AND start AND NOT stop AND NOT LSHH;\nt2 := x1 AND (stop OR LSHH OR timer_done);\n\n(* Apply the enabled transition. *)\nIF t1 THEN\n    x0 := FALSE;\n    x1 := TRUE;\nELSIF t2 THEN\n    x1 := FALSE;\n    x0 := TRUE;\nEND_IF;\n\n(* Start timing on entry and reset timing immediately on exit. *)\nIF t1 OR t2 THEN\n    filling_timer(IN := x1, PT := TimerDuration);\n    timer_done := FALSE;\nEND_IF;\n\n(* Continuous, non-stored GRAFCET actions. *)\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable filling-time parameter; set to the required duration. *)\n    TimerDuration : TIME := T#10s;\n    start_edge : R_TRIG;\n    filling_control : FillingRuntime;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\nfilling_control(\n    start := start_edge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := filling_control.fill_valve;\nDischargeValve := filling_control.discharge_valve;\n\nEND_PROGRAM",
