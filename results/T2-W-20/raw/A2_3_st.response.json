     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TimedTank\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    start_edge : R_TRIG;\n    filling_timer : TON;\n    start : BOOL;\n    stop : BOOL;\n    timer_done : BOOL;\n    active_state : INT := 0;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\n(* Apply stop priority and the idle-to-filling transition. *)\nIF stop THEN\n    active_state := 0;\nELSE\n    CASE active_state OF\n        0:\n            IF start AND NOT LSHH THEN\n                active_state := 1;\n            END_IF;\n        1:\n            IF LSHH THEN\n                active_state := 0;\n            END_IF;\n    ELSE\n        active_state := 0;\n    END_CASE;\nEND_IF;\n\n(* Start timing in the same scan that the filling step is entered. *)\nfilling_timer(\n    IN := (active_state = 1),\n    PT := TimerDuration\n);\ntimer_done := filling_timer.Q;\n\nIF (active_state = 1) AND (stop OR LSHH OR timer_done) THEN\n    active_state := 0;\n\n    (* Reset the owned timer immediately when its step is deactivated. *)\n    filling_timer(IN := FALSE, PT := TimerDuration);\n    timer_done := filling_timer.Q;\nEND_IF;\n\nfill_valve := (active_state = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configure this parameter to the required filling duration. *)\n    TimerDuration : TIME := T#0s;\n    tank_controller : FB_TimedTank;\nEND_VAR\n\ntank_controller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := tank_controller.fill_valve;\nDischargeValve := tank_controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
