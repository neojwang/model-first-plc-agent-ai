     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingTankControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\n\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nVAR\n    state : INT := 0;\n    filling_active : BOOL;\n    start : BOOL;\n    stop : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    start_edge : R_TRIG;\n    filling_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Generate a one-scan event when StartCommand rises. *)\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\n(* Both timers are driven by the activity of the filling step. *)\nfilling_active := (state = 1);\nfilling_timer(IN := filling_active, PT := TON_Duration);\npause_timer(IN := filling_active, PT := TOF_Duration);\nton_q := filling_timer.Q;\ntof_q := pause_timer.Q;\n\n(* Stop and level switches take priority over all other transitions.\n   LSHH is an independent high-high shutdown interlock. *)\nIF stop OR LSH OR LSHH THEN\n    state := 0;\nELSE\n    CASE state OF\n        0:\n            IF start THEN\n                state := 1;\n            END_IF;\n\n        1:\n            IF ton_q AND NOT LSH THEN\n                state := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                state := 1;\n            END_IF;\n\n    ELSE\n        state := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (state = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\n\nVAR\n    (* Adjustable initial parameter values. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n    controller : FillingTankControl;\nEND_VAR\n\ncontroller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := controller.fill_valve;\nDischargeValve := controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
