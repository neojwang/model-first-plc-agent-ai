     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    current_step : INT := 0;\n    filling_timer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\n(* Stop and high-high level prevent entry into the filling step. *)\nIF stop THEN\n    current_step := 0;\nELSIF (current_step = 0) AND start AND NOT LSHH THEN\n    current_step := 1;\nEND_IF;\n\nfilling_timer(\n    IN := (current_step = 1) AND NOT stop AND NOT LSHH,\n    PT := TimerDuration\n);\ntimer_done := filling_timer.Q;\n\nCASE current_step OF\n    0:\n        fill_valve := FALSE;\n\n    1:\n        IF stop OR LSHH OR timer_done THEN\n            current_step := 0;\n            fill_valve := FALSE;\n        ELSE\n            fill_valve := TRUE;\n        END_IF;\n\nELSE\n    current_step := 0;\n    fill_valve := FALSE;\nEND_CASE;\n\ndischarge_valve := FALSE;\n\n(* Reset immediately on leaving the filling step. *)\nIF current_step = 0 THEN\n    filling_timer(IN := FALSE, PT := TimerDuration);\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TimerDuration : TIME := T#10s;\n    start : BOOL := FALSE;\n    stop : BOOL := FALSE;\n    start_edge : R_TRIG;\n    controller : FillingControl;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\ncontroller(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := controller.fill_valve;\nDischargeValve := controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
   ],
