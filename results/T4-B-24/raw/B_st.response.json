   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    start       : BOOL;\n    stop        : BOOL;\n    LevelMeter  : INT;\n    FULL_SCALE  : INT;\n    h_span      : REAL;\n    h_target    : REAL;\n    h_max       : REAL;\n    eps         : REAL;\n    t_h         : TIME;\n    Kp          : REAL;\n    Ti          : REAL;\n    Td          : REAL;\n    cycle_s     : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    settled         : BOOL;\n    r               : INT;\n    fill_valve      : BOOL;\n    discharge_valve : BOOL;\n    FillValve       : INT;\n    DischargeValve  : INT;\nEND_VAR\n\nVAR CONSTANT\n    (* Region encoding: LOW = 0, MID = 1, HIGH = 2.\n       Prefixes avoid the reserved standard function name MID. *)\n    REGION_LOW  : INT := 0;\n    REGION_MID  : INT := 1;\n    REGION_HIGH : INT := 2;\nEND_VAR\n\nVAR\n    phase             : INT := 0;\n    hold_timer        : TON;\n    h                 : REAL;\n    e                 : REAL;\n    previous_error    : REAL := 0.0;\n    integral_term     : REAL := 0.0;\n    integral_trial    : REAL;\n    proportional_term : REAL;\n    derivative_term   : REAL;\n    output_trial      : REAL;\n    output_percent    : REAL;\n    scale_real        : REAL;\nEND_VAR\n\n(* Convert the analog input to the level measuring span. *)\nscale_real := INT_TO_REAL(FULL_SCALE);\n\nIF FULL_SCALE > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span / scale_real;\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_target - h;\n\nIF h < h_target THEN\n    r := REGION_LOW;\nELSIF h < h_max THEN\n    r := REGION_MID;\nELSE\n    r := REGION_HIGH;\nEND_IF;\n\n(* Default outputs also implement the idle and stop behavior. *)\nfill_valve := FALSE;\ndischarge_valve := FALSE;\nFillValve := 0;\nDischargeValve := 0;\n\nIF stop THEN\n    phase := 0;\nELSE\n    CASE phase OF\n        0:\n            IF start THEN\n                integral_term := 0.0;\n                previous_error := e;\n                phase := 1;\n            END_IF;\n\n        1:\n            IF r = REGION_HIGH THEN\n                phase := 0;\n            END_IF;\n\n        ELSE\n            phase := 0;\n    END_CASE;\nEND_IF;\n\n(* TON resets whenever the tolerance band is left or regulation ends. *)\nhold_timer(\n    IN := (phase = 1) AND NOT stop\n          AND (r <> REGION_HIGH) AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := hold_timer.Q;\n\nIF settled THEN\n    phase := 0;\nEND_IF;\n\nIF phase = 1 THEN\n    (* Ideal PID:\n       Kp is percent opening per unit of level;\n       Ti, Td and cycle_s are expressed in seconds. *)\n    proportional_term := Kp * e;\n    derivative_term := 0.0;\n\n    IF cycle_s > 0.0 THEN\n        derivative_term := Kp * Td * (e - previous_error) / cycle_s;\n    END_IF;\n\n    integral_trial := integral_term;\n\n    IF (Ti > 0.0) AND (cycle_s > 0.0) THEN\n        integral_trial := integral_term + Kp * e * cycle_s / Ti;\n    END_IF;\n\n    output_trial := proportional_term + integral_trial + derivative_term;\n\n    (* Suspend integration whenever the proposed output is clamped. *)\n    IF output_trial > 100.0 THEN\n        output_percent := 100.0;\n    ELSIF output_trial < 0.0 THEN\n        output_percent := 0.0;\n    ELSE\n        output_percent := output_trial;\n        integral_term := integral_trial;\n    END_IF;\n\n    previous_error := e;\n\n    IF FULL_SCALE > 0 THEN\n        fill_valve := TRUE;\n        discharge_valve := TRUE;\n\n        FillValve := REAL_TO_INT(output_percent * scale_real / 100.0);\n        DischargeValve := REAL_TO_INT(0.4 * scale_real);\n\n        IF FillValve < 0 THEN\n            FillValve := 0;\n        ELSIF FillValve > FULL_SCALE THEN\n            FillValve := FULL_SCALE;\n        END_IF;\n    END_IF;\nELSE\n    integral_term := 0.0;\n    previous_error := e;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand   AT %IX100.0 : BOOL;\n    StopCommand    AT %IX100.1 : BOOL;\n    LevelMeter     AT %IW100   : INT;\n    FillValve      AT %QW100   : INT;\n    DischargeValve AT %QW101   : INT;\nEND_VAR\n\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    cycle_s    : REAL := 0.1;\nEND_VAR\n\nVAR\n    h_span   : REAL := 10.0;\n    h_sp     : REAL;\n    h_target : REAL;\n    h_max    : REAL;\n    eps      : REAL;\n    t_h      : TIME := T#10s;\n\n    (* Initial tuning values; adjust for the actual tank dynamics. *)\n    Kp : REAL := 20.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n\n    start           : BOOL;\n    stop            : BOOL;\n    settled         : BOOL;\n    r               : INT;\n    fill_valve      : BOOL;\n    discharge_valve : BOOL;\n\n    start_edge : R_TRIG;\n    controller : LevelControl;\nEND_VAR\n\nh_sp := 0.8 * h_span;\nh_target := h_sp;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\ncontroller(\n    start := start,\n    stop := stop,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    h_target := h_target,\n    h_max := h_max,\n    eps := eps,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    cycle_s := cycle_s\n);\n\nsettled := controller.settled;\nr := controller.r;\nfill_valve := controller.fill_valve;\ndischarge_valve := controller.discharge_valve;\n\nFillValve := controller.FillValve;\nDischargeValve := controller.DischargeValve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config\n    RESOURCE Res ON PLC\n        TASK ControlTask(INTERVAL := T#100ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
     "annotations": [],
     "logprobs": []
    }
