     "type": "output_text",
     "text": "FUNCTION_BLOCK TankFillingControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    active_state : INT := 0;\n    start_edge : R_TRIG;\n    filling_timer : TON;\n    pause_timer : TOF;\n    start : BOOL;\n    stop : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    x0 : BOOL;\n    x1 : BOOL;\n    x2 : BOOL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\n(* Both timers receive the activity of the filling step. *)\nx1 := (active_state = 1);\nfilling_timer(IN := x1, PT := TON_Duration);\npause_timer(IN := x1, PT := TOF_Duration);\nton_q := filling_timer.Q;\ntof_q := pause_timer.Q;\n\n(* Evaluate transitions from the current situation only. *)\nIF stop THEN\n    active_state := 0;\nELSE\n    CASE active_state OF\n        0:\n            IF start AND NOT LSH THEN\n                active_state := 1;\n            END_IF;\n\n        1:\n            IF LSH THEN\n                active_state := 0;\n            ELSIF ton_q THEN\n                active_state := 2;\n            END_IF;\n\n        2:\n            IF LSH THEN\n                active_state := 0;\n            ELSIF NOT tof_q THEN\n                active_state := 1;\n            END_IF;\n\n        ELSE\n            active_state := 0;\n    END_CASE;\nEND_IF;\n\nx0 := (active_state = 0);\nx1 := (active_state = 1);\nx2 := (active_state = 2);\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\n(* LSHH is an observation input, not an additional GRAFCET transition.\n   Prevention of LSHH depends on termination at LSH and plant response. *)\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    tank_controller : TankFillingControl;\n    (* Commissioning defaults; adjust to the required process timings. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\nEND_VAR\n\ntank_controller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := tank_controller.fill_valve;\nDischargeValve := tank_controller.discharge_valve;\nEND_PROGRAM",
