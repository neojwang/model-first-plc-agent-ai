     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    phase : INT := 0;\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    FillTimer : TON;\n    PauseTimer : TOF;\nEND_VAR\n\n(* Stop and either level switch have priority over starting. *)\nIF stop OR LSH OR LSHH THEN\n    phase := 0;\nELSIF (phase = 0) AND start THEN\n    phase := 1;\nEND_IF;\n\n(* Both timers are evaluated every scan. *)\nfilling_active := (phase = 1);\n\nFillTimer(\n    IN := filling_active,\n    PT := TON_Duration\n);\nton_q := FillTimer.Q;\n\nPauseTimer(\n    IN := filling_active,\n    PT := TOF_Duration\n);\ntof_q := PauseTimer.Q;\n\nCASE phase OF\n    0:\n        fill_valve := FALSE;\n\n    1:\n        IF ton_q THEN\n            phase := 2;\n        END_IF;\n\n    2:\n        IF NOT tof_q THEN\n            phase := 1;\n        END_IF;\n\nELSE\n    phase := 0;\nEND_CASE;\n\nfill_valve := (phase = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable example parameter values. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start : BOOL;\n    stop : BOOL;\n    StartEdge : R_TRIG;\n    TankControl : FB_TankControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nTankControl(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := TankControl.fill_valve;\nDischargeValve := TankControl.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
