     "type": "output_text",
     "text": "FUNCTION_BLOCK TankFillingRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    t1 : BOOL;\n    t2 : BOOL;\n    timer_done : BOOL := FALSE;\n    FillingTimer : TON;\nEND_VAR\n\n(* Evaluate the start transition from the current situation. *)\nt1 := x0 AND start AND NOT stop AND NOT LSHH;\n\n(* Start timing in the same scan that the filling step is entered. *)\nFillingTimer(\n    IN := x1 OR t1,\n    PT := TimerDuration\n);\n\n(* The owned condition is neutral on entry to x1. *)\ntimer_done := x1 AND FillingTimer.Q;\n\n(* Evaluate the return transition before updating the situation. *)\nt2 := x1 AND (stop OR LSHH OR timer_done);\n\nIF t1 THEN\n    x0 := FALSE;\n    x1 := TRUE;\nELSIF t2 THEN\n    x0 := TRUE;\n    x1 := FALSE;\nEND_IF;\n\n(* Reset the owned timer immediately when its step is inactive. *)\nIF NOT x1 THEN\n    FillingTimer(IN := FALSE, PT := TimerDuration);\n    timer_done := FALSE;\nEND_IF;\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable filling duration. *)\n    TimerDuration : TIME := T#10s;\n    StartEdge : R_TRIG;\n    FillingControl : TankFillingRuntime;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nFillingControl(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := FillingControl.fill_valve;\nDischargeValve := FillingControl.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
