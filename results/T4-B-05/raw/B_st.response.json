     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\n    CycleSeconds : REAL;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    (* r: 0 = LOW, 1 = MID, 2 = HIGH.\n       MID is not declared as an identifier because it is reserved. *)\n    r : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n    StateNumber : INT := 0;\n    h_span : REAL := 10.0;\n    h_target : REAL;\n    h_sp : REAL;\n    h_max : REAL;\n    eps : REAL;\n    t_h : TIME := T#10s;\n    h : REAL;\n    e : REAL;\n    PreviousError : REAL := 0.0;\n    IntegralTerm : REAL := 0.0;\n    CandidateIntegral : REAL;\n    ProportionalTerm : REAL;\n    DerivativeTerm : REAL;\n    RawOutput : REAL;\n    ValvePercent : REAL;\nEND_VAR\n\nh_target := 0.8 * h_span;\nh_sp := h_target;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nh := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := 0; (* LOW *)\nELSIF h < h_max THEN\n    r := 1; (* MID *)\nELSE\n    r := 2; (* HIGH *)\nEND_IF;\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\n(* Default outputs implement the idle and stopped conditions. *)\nFillValve := 0;\nDischargeValve := 0;\nfill_valve := FALSE;\ndischarge_valve := FALSE;\n\nIF stop THEN\n    StateNumber := 0;\nELSIF (StateNumber = 0) AND start THEN\n    StateNumber := 1;\n    IntegralTerm := 0.0;\n    PreviousError := e;\nEND_IF;\n\nHoldTimer(\n    IN := (StateNumber = 1) AND NOT stop AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nCASE StateNumber OF\n    0:\n        IntegralTerm := 0.0;\n        PreviousError := e;\n\n    1:\n        IF settled OR (r = 2) THEN\n            StateNumber := 0;\n            IntegralTerm := 0.0;\n            PreviousError := e;\n        ELSE\n            ProportionalTerm := Kp * e;\n\n            DerivativeTerm := 0.0;\n            IF (CycleSeconds > 0.0) AND (Td > 0.0) THEN\n                DerivativeTerm :=\n                    Kp * Td * (e - PreviousError) / CycleSeconds;\n            END_IF;\n\n            CandidateIntegral := IntegralTerm;\n            IF (Ti > 0.0) AND (CycleSeconds > 0.0) THEN\n                CandidateIntegral :=\n                    IntegralTerm + Kp * e * CycleSeconds / Ti;\n            END_IF;\n\n            RawOutput :=\n                ProportionalTerm + CandidateIntegral + DerivativeTerm;\n\n            (* Freeze the integral whenever the proposed output\n               requires clamping. Output units are percent opening. *)\n            IF RawOutput > 100.0 THEN\n                ValvePercent := 100.0;\n            ELSIF RawOutput < 0.0 THEN\n                ValvePercent := 0.0;\n            ELSE\n                ValvePercent := RawOutput;\n                IntegralTerm := CandidateIntegral;\n            END_IF;\n\n            PreviousError := e;\n\n            fill_valve := TRUE;\n            discharge_valve := TRUE;\n            FillValve := REAL_TO_INT(\n                ValvePercent * INT_TO_REAL(FULL_SCALE) / 100.0\n            );\n            DischargeValve :=\n                REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\n        END_IF;\n\nELSE\n    StateNumber := 0;\n    IntegralTerm := 0.0;\n    PreviousError := e;\nEND_CASE;\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    CycleSeconds : REAL := 0.02;\nEND_VAR\nVAR\n    (* Initial tuning values; tune for the connected tank.\n       Kp: percent opening per volt; Ti and Td: seconds. *)\n    Kp : REAL := 25.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    Controller : LevelControl;\nEND_VAR\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    CycleSeconds := CycleSeconds\n);\n\nFillValve := Controller.FillValve;\nDischargeValve := Controller.DischargeValve;\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
