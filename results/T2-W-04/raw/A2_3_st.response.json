     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TimedTank\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    FillingTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    timer_done : BOOL;\n    ActiveStep : INT := 0;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nIF stop THEN\n    ActiveStep := 0;\nELSE\n    CASE ActiveStep OF\n        0:\n            IF start THEN\n                ActiveStep := 1;\n            END_IF;\n        1:\n            ActiveStep := 1;\n    ELSE\n        ActiveStep := 0;\n    END_CASE;\nEND_IF;\n\nFillingTimer(IN := (ActiveStep = 1), PT := TimerDuration);\ntimer_done := FillingTimer.Q;\n\nIF ActiveStep = 1 THEN\n    IF stop OR timer_done OR LSHH THEN\n        ActiveStep := 0;\n        FillingTimer(IN := FALSE, PT := TimerDuration);\n        timer_done := FillingTimer.Q;\n    END_IF;\nEND_IF;\n\nfill_valve := (ActiveStep = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TimerDuration : TIME;\n    TankController : FB_TimedTank;\nEND_VAR\n\nTankController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
