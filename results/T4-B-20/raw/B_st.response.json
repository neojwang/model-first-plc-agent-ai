  {
   "type": "message",
   "id": "msg_0b266398c52c253a016af9b15864bc87d0a2c000ddf141f0f1",
   "role": "assistant",
   "status": "completed",
   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    h_span : REAL;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\n    FillDemand : INT;\n    DischargeDemand : INT;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n\n    (* Region encoding: 0 = LOW, 1 = MID, 2 = HIGH.\n       MID is a standard function name, so it is not an identifier. *)\n    r : INT := 0;\n    ControlState : INT := 0;\n\n    h : REAL;\n    h_target : REAL;\n    h_sp : REAL;\n    h_max : REAL;\n    eps : REAL;\n    e : REAL;\n    PreviousError : REAL := 0.0;\n\n    IntegralTerm : REAL := 0.0;\n    CandidateIntegral : REAL;\n    ProportionalTerm : REAL;\n    DerivativeTerm : REAL;\n    UnclampedOutput : REAL;\n    CandidateOutput : REAL;\n    ValvePercent : REAL;\n    FirstPidScan : BOOL := TRUE;\nEND_VAR\nVAR CONSTANT\n    CycleSeconds : REAL := 0.02;\n    t_h : TIME := T#10s;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nh_target := 0.8 * h_span;\nh_sp := h_target;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nIF FULL_SCALE > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := 0;\nELSIF h < h_max THEN\n    r := 1;\nELSE\n    r := 2;\nEND_IF;\n\nIF stop THEN\n    ControlState := 0;\nELSIF (ControlState = 0) AND start THEN\n    ControlState := 1;\n    FirstPidScan := TRUE;\nEND_IF;\n\nHoldTimer(\n    IN := (ControlState = 1)\n          AND NOT stop\n          AND (r <> 2)\n          AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nIF (ControlState = 1) AND (settled OR (r = 2)) THEN\n    ControlState := 0;\nEND_IF;\n\nfill_valve := FALSE;\ndischarge_valve := FALSE;\nFillDemand := 0;\nDischargeDemand := 0;\n\nCASE ControlState OF\n    0:\n        IntegralTerm := 0.0;\n        PreviousError := e;\n        FirstPidScan := TRUE;\n        ValvePercent := 0.0;\n\n    1:\n        fill_valve := TRUE;\n        discharge_valve := TRUE;\n\n        (* Discrete PID: Kp is percent opening per level unit;\n           Ti and Td are in seconds. Ti <= 0 disables integration. *)\n        ProportionalTerm := Kp * e;\n\n        IF FirstPidScan THEN\n            PreviousError := e;\n            FirstPidScan := FALSE;\n        END_IF;\n\n        DerivativeTerm :=\n            Kp * Td * (e - PreviousError) / CycleSeconds;\n\n        UnclampedOutput :=\n            ProportionalTerm + IntegralTerm + DerivativeTerm;\n\n        (* Conditional integration: freeze the integrator whenever the\n           output is clamped, and reject increments causing saturation. *)\n        IF Ti > 0.0 THEN\n            IF (UnclampedOutput >= 0.0)\n               AND (UnclampedOutput <= 100.0) THEN\n                CandidateIntegral :=\n                    IntegralTerm + Kp * e * CycleSeconds / Ti;\n                CandidateOutput :=\n                    ProportionalTerm + CandidateIntegral + DerivativeTerm;\n\n                IF (CandidateOutput >= 0.0)\n                   AND (CandidateOutput <= 100.0) THEN\n                    IntegralTerm := CandidateIntegral;\n                END_IF;\n            END_IF;\n        ELSE\n            IntegralTerm := 0.0;\n        END_IF;\n\n        UnclampedOutput :=\n            ProportionalTerm + IntegralTerm + DerivativeTerm;\n\n        IF UnclampedOutput > 100.0 THEN\n            ValvePercent := 100.0;\n        ELSIF UnclampedOutput < 0.0 THEN\n            ValvePercent := 0.0;\n        ELSE\n            ValvePercent := UnclampedOutput;\n        END_IF;\n\n        PreviousError := e;\n\n        IF FULL_SCALE > 0 THEN\n            FillDemand := REAL_TO_INT(\n                ValvePercent * INT_TO_REAL(FULL_SCALE) / 100.0\n            );\n            DischargeDemand := REAL_TO_INT(\n                0.4 * INT_TO_REAL(FULL_SCALE)\n            );\n        END_IF;\n\nELSE\n    ControlState := 0;\n    IntegralTerm := 0.0;\n    FirstPidScan := TRUE;\nEND_CASE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\nEND_VAR\nVAR\n    Controller : LevelControl;\n    h_span : REAL := 10.0;\n    Kp : REAL := 25.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\nEND_VAR\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td\n);\n\nFillValve := Controller.FillDemand;\nDischargeValve := Controller.DischargeDemand;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
