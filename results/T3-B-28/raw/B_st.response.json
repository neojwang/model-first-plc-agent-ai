    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_FillingTank\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    current_state : INT := 0;\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    fill_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Stop and either level switch take priority over starting or filling.\n   LSHH is an additional fail-safe shutdown input. *)\nIF stop OR LSH OR LSHH THEN\n    current_state := 0;\nELSIF (current_state = 0) AND start THEN\n    current_state := 1;\nEND_IF;\n\nfilling_active := (current_state = 1);\n\nfill_timer(\n    IN := filling_active,\n    PT := TON_Duration\n);\nton_q := fill_timer.Q;\n\n(* End the filling phase as soon as TON expires. *)\nIF (current_state = 1) AND ton_q THEN\n    current_state := 2;\nEND_IF;\n\n(* Calling TOF after the filling-to-pause transition starts its\n   off-delay in the same scan that the fill valve closes. *)\nfilling_active := (current_state = 1);\n\npause_timer(\n    IN := filling_active,\n    PT := TOF_Duration\n);\ntof_q := pause_timer.Q;\n\nCASE current_state OF\n    0:\n        fill_valve := FALSE;\n\n    1:\n        fill_valve := TRUE;\n\n    2:\n        fill_valve := FALSE;\n        IF NOT tof_q THEN\n            (* Resume on the next scan, keeping this scan's output off.\n               TON has already been reset during this pause scan. *)\n            current_state := 1;\n        END_IF;\n\nELSE\n    current_state := 0;\n    fill_valve := FALSE;\nEND_CASE;\n\ndischarge_valve := FALSE;\n\nIF stop OR LSH OR LSHH THEN\n    current_state := 0;\n    fill_valve := FALSE;\n    discharge_valve := FALSE;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start : BOOL;\n    stop : BOOL;\n    start_edge : R_TRIG;\n    tank_control : FB_FillingTank;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\ntank_control(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := tank_control.fill_valve;\nDischargeValve := tank_control.discharge_valve;\n\nEND_PROGRAM",
