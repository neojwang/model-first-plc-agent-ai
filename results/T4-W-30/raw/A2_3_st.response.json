   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT := 1000;\n    h_span : REAL := 10.0;\n    h_sp : REAL := 8.0;\n    h_target : REAL := 8.0;\n    h_max : REAL := 9.0;\n    eps : REAL := 0.2;\n    t_h : TIME := T#10s;\n    Kp : REAL := 0.5;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\n    CycleTime : TIME := T#20ms;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT;\n    StateNumber : INT := 0;\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    WasRegulating : BOOL := FALSE;\n    h : REAL;\n    e : REAL;\n    PreviousError : REAL := 0.0;\n    SampleSeconds : REAL;\n    IntegralTerm : REAL := 0.0;\n    DerivativeTerm : REAL := 0.0;\n    RawDemand : REAL := 0.0;\n    BoundedDemand : REAL := 0.0;\nEND_VAR\n\n(* PID demand is a fraction of full valve opening.\n   Kp is expressed in opening fraction per level unit;\n   Ti and Td are expressed in seconds.\n   CycleTime must match the cyclic task period. *)\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nIF FULL_SCALE > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_sp - h;\n\n(* Region encoding: 0 = LOW, 1 = MID, 2 = HIGH. *)\nIF h >= h_max THEN\n    r := 2;\nELSIF h >= h_target THEN\n    r := 1;\nELSE\n    r := 0;\nEND_IF;\n\nx0 := StateNumber = 0;\nx1 := StateNumber = 1;\n\n(* The hold interval must be continuous and confined to regulation. *)\nHoldTimer(\n    IN := x1 AND NOT stop AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nIF stop THEN\n    StateNumber := 0;\nELSE\n    CASE StateNumber OF\n        0:\n            IF start AND (r <> 2) THEN\n                StateNumber := 1;\n            END_IF;\n        1:\n            IF settled OR (r = 2) THEN\n                StateNumber := 0;\n            END_IF;\n    ELSE\n        StateNumber := 0;\n    END_CASE;\nEND_IF;\n\nx0 := StateNumber = 0;\nx1 := StateNumber = 1;\n\nfill_valve := x1;\ndischarge_valve := x1;\n\nSampleSeconds := TIME_TO_REAL(CycleTime) / 1000.0;\n\nFillValve := 0;\nDischargeValve := 0;\n\nIF x1 AND (FULL_SCALE > 0) THEN\n    IF NOT WasRegulating THEN\n        IntegralTerm := 0.0;\n        PreviousError := e;\n    END_IF;\n\n    DerivativeTerm := 0.0;\n    IF (SampleSeconds > 0.0) AND (Td > 0.0) THEN\n        DerivativeTerm :=\n            Kp * Td * (e - PreviousError) / SampleSeconds;\n    END_IF;\n\n    RawDemand := Kp * e + IntegralTerm + DerivativeTerm;\n\n    IF RawDemand >= 1.0 THEN\n        BoundedDemand := 1.0;\n    ELSIF RawDemand <= 0.0 THEN\n        BoundedDemand := 0.0;\n    ELSE\n        BoundedDemand := RawDemand;\n    END_IF;\n\n    (* Forward-Euler integration updates the next scan's integral.\n       Integration is suspended whenever demand is at either limit.\n       Ti <= 0 disables integral action. *)\n    IF Ti <= 0.0 THEN\n        IntegralTerm := 0.0;\n    ELSIF (SampleSeconds > 0.0)\n          AND (RawDemand > 0.0)\n          AND (RawDemand < 1.0) THEN\n        IntegralTerm :=\n            IntegralTerm + Kp * e * SampleSeconds / Ti;\n    END_IF;\n\n    PreviousError := e;\n\n    FillValve :=\n        REAL_TO_INT(BoundedDemand * INT_TO_REAL(FULL_SCALE));\n    DischargeValve :=\n        REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\nELSE\n    IntegralTerm := 0.0;\n    DerivativeTerm := 0.0;\n    RawDemand := 0.0;\n    BoundedDemand := 0.0;\n    PreviousError := e;\nEND_IF;\n\nWasRegulating := x1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\nEND_VAR\nVAR\n    Controller : FB_LevelControl;\n    h_span : REAL := 10.0;\n    h_sp : REAL := 8.0;\n    h_target : REAL := 8.0;\n    h_max : REAL := 9.0;\n    eps : REAL := 0.2;\n    t_h : TIME := T#10s;\n    Kp : REAL := 0.5;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\n    CycleTime : TIME := T#20ms;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\n(* Configure Main's cyclic task with the same period as CycleTime.\n   The gain defaults are commissioning values and require plant tuning. *)\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    h_sp := h_sp,\n    h_target := h_target,\n    h_max := h_max,\n    eps := eps,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    CycleTime := CycleTime\n);\n\nFillValve := Controller.FillValve;\nDischargeValve := Controller.DischargeValve;\nfill_valve := Controller.fill_valve;\ndischarge_valve := Controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
