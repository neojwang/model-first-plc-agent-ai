   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    Kp : REAL := 1.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    CycleSeconds : REAL := 0.02;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    h_span : REAL := 10.0;\n    h_sp : REAL := 8.0;\n    h_target : REAL := 8.0;\n    h_max : REAL := 9.0;\n    eps : REAL := 0.2;\n    t_h : TIME := T#10s;\n    REGION_LOW : INT := 0;\n    REGION_MIDDLE : INT := 1;\n    REGION_HIGH : INT := 2;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT;\n    StateNumber : INT := 0;\n    EnteringRegulation : BOOL;\n    h : REAL;\n    ErrorValue : REAL;\n    PreviousError : REAL := 0.0;\n    ProportionalTerm : REAL;\n    IntegralTerm : REAL := 0.0;\n    CandidateIntegral : REAL;\n    DerivativeTerm : REAL;\n    UnboundedDemand : REAL;\n    BoundedDemand : REAL;\n    SampleSeconds : REAL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nh := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nErrorValue := h_sp - h;\n\nIF h < h_target THEN\n    r := REGION_LOW;\nELSIF h < h_max THEN\n    r := REGION_MIDDLE;\nELSE\n    r := REGION_HIGH;\nEND_IF;\n\nSampleSeconds := CycleSeconds;\nIF SampleSeconds <= 0.0 THEN\n    SampleSeconds := 0.02;\nEND_IF;\n\nEnteringRegulation := FALSE;\n\nIF stop THEN\n    StateNumber := 0;\nELSE\n    CASE StateNumber OF\n        0:\n            IF start THEN\n                StateNumber := 1;\n                EnteringRegulation := TRUE;\n            END_IF;\n        1:\n            StateNumber := 1;\n    ELSE\n        StateNumber := 0;\n    END_CASE;\nEND_IF;\n\nHoldTimer(\n    IN := (StateNumber = 1)\n          AND NOT stop\n          AND (r <> REGION_HIGH)\n          AND (ABS(ErrorValue) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nIF (StateNumber = 1)\n   AND (stop OR settled OR (r = REGION_HIGH)) THEN\n    StateNumber := 0;\nEND_IF;\n\nfill_valve := StateNumber = 1;\ndischarge_valve := StateNumber = 1;\n\nFillValve := 0;\nDischargeValve := 0;\n\nIF fill_valve THEN\n    IF EnteringRegulation THEN\n        IntegralTerm := 0.0;\n        PreviousError := ErrorValue;\n    END_IF;\n\n    (* PID demand is expressed as a fraction of full valve opening.\n       Ti and Td are expressed in seconds. *)\n    ProportionalTerm := Kp * ErrorValue;\n    DerivativeTerm :=\n        Kp * Td * (ErrorValue - PreviousError) / SampleSeconds;\n\n    CandidateIntegral := IntegralTerm;\n    IF Ti > 0.0 THEN\n        CandidateIntegral :=\n            IntegralTerm + Kp * ErrorValue * SampleSeconds / Ti;\n    ELSE\n        IntegralTerm := 0.0;\n        CandidateIntegral := 0.0;\n    END_IF;\n\n    UnboundedDemand :=\n        ProportionalTerm + CandidateIntegral + DerivativeTerm;\n\n    (* Freeze the stored integral whenever the demand is clamped. *)\n    IF UnboundedDemand > 1.0 THEN\n        BoundedDemand := 1.0;\n    ELSIF UnboundedDemand < 0.0 THEN\n        BoundedDemand := 0.0;\n    ELSE\n        BoundedDemand := UnboundedDemand;\n        IntegralTerm := CandidateIntegral;\n    END_IF;\n\n    PreviousError := ErrorValue;\n\n    FillValve :=\n        REAL_TO_INT(BoundedDemand * INT_TO_REAL(FULL_SCALE));\n    DischargeValve :=\n        REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\nELSE\n    IntegralTerm := 0.0;\n    PreviousError := ErrorValue;\n    BoundedDemand := 0.0;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR\n    LevelController : FB_LevelControl;\n    Kp : REAL := 1.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nLevelController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    CycleSeconds := 0.02\n);\n\nFillValve := LevelController.FillValve;\nDischargeValve := LevelController.DischargeValve;\nfill_valve := LevelController.fill_valve;\ndischarge_valve := LevelController.discharge_valve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
