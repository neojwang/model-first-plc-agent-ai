     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TimedTankFilling\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    SequenceState : INT := 0;\n    FillingActive : BOOL;\n    FillingTimer : TON;\n    PauseTimer : TOF;\n    ton_q : BOOL;\n    tof_q : BOOL;\nEND_VAR\n\n(* Both standard timers measure the activity of the filling step. *)\nFillingActive := (SequenceState = 1);\n\nFillingTimer(\n    IN := FillingActive,\n    PT := TON_Duration\n);\n\nPauseTimer(\n    IN := FillingActive,\n    PT := TOF_Duration\n);\n\nton_q := FillingTimer.Q;\ntof_q := PauseTimer.Q;\n\n(* Stop has priority over every normal transition. *)\nIF stop THEN\n    SequenceState := 0;\nELSE\n    CASE SequenceState OF\n        0:\n            IF start AND NOT LSH THEN\n                SequenceState := 1;\n            END_IF;\n\n        1:\n            IF LSH THEN\n                SequenceState := 0;\n            ELSIF ton_q THEN\n                SequenceState := 2;\n            END_IF;\n\n        2:\n            IF LSH THEN\n                SequenceState := 0;\n            ELSIF NOT tof_q THEN\n                SequenceState := 1;\n            END_IF;\n\n        ELSE\n            SequenceState := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (SequenceState = 1);\ndischarge_valve := FALSE;\n\n(* LSHH is available for monitoring; the GRAFCET defines no LSHH trip. *)\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Example presets; configure these for the plant. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n    StartEdge : R_TRIG;\n    TankController : FB_TimedTankFilling;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nTankController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
