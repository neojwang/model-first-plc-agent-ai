   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    h_span : REAL;\n    h_target : REAL;\n    h_sp : REAL;\n    h_max : REAL;\n    eps : REAL;\n    t_h : TIME;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\n    cycle_seconds : REAL;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT;\n    state_id : INT := 0;\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    was_active : BOOL := FALSE;\n    h : REAL;\n    e : REAL;\n    previous_error : REAL := 0.0;\n    proportional_term : REAL;\n    integral_term : REAL := 0.0;\n    candidate_integral : REAL;\n    derivative_term : REAL;\n    raw_demand : REAL;\n    bounded_demand : REAL;\nEND_VAR\n\n(* Region coding: 0 = LOW, 1 = MID, 2 = HIGH. *)\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nh := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\ne := h_sp - h;\n\nIF h >= h_max THEN\n    r := 2;\nELSIF h >= h_target THEN\n    r := 1;\nELSE\n    r := 0;\nEND_IF;\n\n(* The hold condition measures uninterrupted time inside the tolerance\n   band while regulation is active. *)\nHoldTimer(\n    IN := (state_id = 1) AND NOT stop\n          AND (r <> 2) AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nIF stop THEN\n    state_id := 0;\nELSE\n    CASE state_id OF\n        0:\n            IF start AND (r <> 2) THEN\n                state_id := 1;\n            END_IF;\n        1:\n            IF settled OR (r = 2) THEN\n                state_id := 0;\n            END_IF;\n    ELSE\n        state_id := 0;\n    END_CASE;\nEND_IF;\n\nx0 := state_id = 0;\nx1 := state_id = 1;\nfill_valve := x1;\ndischarge_valve := x1;\n\nFillValve := 0;\nDischargeValve := 0;\n\nIF x1 THEN\n    IF NOT was_active THEN\n        integral_term := 0.0;\n        previous_error := e;\n    END_IF;\n\n    (* PID demand is expressed as a fraction of full valve opening.\n       Ti, Td and cycle_seconds are expressed in seconds. *)\n    proportional_term := Kp * e;\n    derivative_term := 0.0;\n    candidate_integral := integral_term;\n\n    IF cycle_seconds > 0.0 THEN\n        derivative_term :=\n            Kp * Td * (e - previous_error) / cycle_seconds;\n\n        IF Ti > 0.0 THEN\n            candidate_integral :=\n                integral_term + Kp * e * cycle_seconds / Ti;\n        ELSE\n            integral_term := 0.0;\n            candidate_integral := 0.0;\n        END_IF;\n    END_IF;\n\n    raw_demand :=\n        proportional_term + candidate_integral + derivative_term;\n\n    (* Reject the integral update whenever the demand is clamped. *)\n    IF raw_demand > 1.0 THEN\n        bounded_demand := 1.0;\n    ELSIF raw_demand < 0.0 THEN\n        bounded_demand := 0.0;\n    ELSE\n        bounded_demand := raw_demand;\n        integral_term := candidate_integral;\n    END_IF;\n\n    FillValve :=\n        REAL_TO_INT(bounded_demand * INT_TO_REAL(FULL_SCALE));\n    DischargeValve :=\n        REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\n\n    previous_error := e;\nELSE\n    integral_term := 0.0;\n    candidate_integral := 0.0;\n    derivative_term := 0.0;\n    proportional_term := 0.0;\n    raw_demand := 0.0;\n    bounded_demand := 0.0;\n    previous_error := e;\nEND_IF;\n\nwas_active := x1;\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    h_span : REAL := 10.0;\n    h_sp : REAL := 8.0;\n    h_target : REAL := 8.0;\n    h_max : REAL := 9.0;\n    eps : REAL := 0.2;\n    t_h : TIME := T#10s;\n    cycle_seconds : REAL := 0.02;\nEND_VAR\nVAR\n    Controller : FB_LevelControl;\n    (* Configurable commissioning values; tune for the plant.\n       Kp is opening fraction per volt; Ti and Td are seconds. *)\n    Kp : REAL := 0.1;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    h_target := h_target,\n    h_sp := h_sp,\n    h_max := h_max,\n    eps := eps,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    cycle_seconds := cycle_seconds\n);\n\nFillValve := Controller.FillValve;\nDischargeValve := Controller.DischargeValve;\nfill_valve := Controller.fill_valve;\ndischarge_valve := Controller.discharge_valve;\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
