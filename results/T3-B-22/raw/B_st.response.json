     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_number : INT := 0;\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    FillOnDelay : TON;\n    FillOffDelay : TOF;\nEND_VAR\n\n(* Stop and level switches take priority over normal sequencing. *)\nIF stop OR LSH OR LSHH THEN\n    state_number := 0;\nEND_IF;\n\nfilling_active := (state_number = 1);\n\nFillOnDelay(IN := filling_active, PT := TON_Duration);\nFillOffDelay(IN := filling_active, PT := TOF_Duration);\n\nton_q := FillOnDelay.Q;\ntof_q := FillOffDelay.Q;\n\nIF NOT (stop OR LSH OR LSHH) THEN\n    CASE state_number OF\n        0:\n            IF start THEN\n                state_number := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                state_number := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                state_number := 1;\n            END_IF;\n\n        ELSE\n            state_number := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (state_number = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable timing parameters. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start : BOOL;\n    stop : BOOL;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\n\n    StartEdge : R_TRIG;\n    TankControl : FillingControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nTankControl(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nfill_valve := TankControl.fill_valve;\ndischarge_valve := TankControl.discharge_valve;\n\nFillValve := fill_valve;\nDischargeValve := discharge_valve;\n\nEND_PROGRAM",
