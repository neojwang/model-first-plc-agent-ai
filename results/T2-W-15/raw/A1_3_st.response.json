     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    ActiveState : INT := 0;\n    PreviousState : INT;\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    FillingTimer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\n(* Evaluate the timer owned by the currently active filling step. *)\nFillingTimer(IN := x1, PT := TimerDuration);\ntimer_done := FillingTimer.Q;\n\nPreviousState := ActiveState;\n\nCASE ActiveState OF\n    0:\n        IF start AND NOT stop AND NOT LSHH THEN\n            ActiveState := 1;\n        END_IF;\n\n    1:\n        IF stop OR LSHH OR timer_done THEN\n            ActiveState := 0;\n        END_IF;\n\nELSE\n    ActiveState := 0;\nEND_CASE;\n\nx0 := ActiveState = 0;\nx1 := ActiveState = 1;\n\n(* Start timing on entry and reset timing on exit. *)\nIF ActiveState <> PreviousState THEN\n    FillingTimer(IN := x1, PT := TimerDuration);\n    timer_done := FALSE;\nEND_IF;\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configure the required filling duration before operation. *)\n    TimerDuration : TIME := T#0s;\n    StartEdge : R_TRIG;\n    RuntimeLogic : FillingRuntime;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nRuntimeLogic(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := RuntimeLogic.fill_valve;\nDischargeValve := RuntimeLogic.discharge_valve;\n\nEND_PROGRAM",
