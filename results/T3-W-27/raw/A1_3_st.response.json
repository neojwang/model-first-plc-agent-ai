     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TankRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_id : INT := 0;\n    previous_state : INT := 0;\n    filling_active : BOOL := FALSE;\n    ton_q : BOOL := FALSE;\n    tof_q : BOOL := FALSE;\n    fill_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Evaluate timers using the current filling-step activity. *)\nfilling_active := (state_id = 1);\n\nfill_timer(IN := filling_active, PT := TON_Duration);\npause_timer(IN := filling_active, PT := TOF_Duration);\n\nton_q := fill_timer.Q;\ntof_q := pause_timer.Q;\n\nprevious_state := state_id;\n\n(* Evaluate transitions from the current situation. *)\nCASE state_id OF\n    0:\n        IF start AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            state_id := 1;\n        END_IF;\n\n    1:\n        IF stop OR LSH OR LSHH THEN\n            state_id := 0;\n        ELSIF ton_q AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            state_id := 2;\n        END_IF;\n\n    2:\n        IF stop OR LSH OR LSHH THEN\n            state_id := 0;\n        ELSIF NOT tof_q AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            state_id := 1;\n        END_IF;\n\nELSE\n    state_id := 0;\nEND_CASE;\n\n(* Synchronize timer inputs immediately with step entry or exit.\n   In particular, the TOF falling edge occurs on entry to pause. *)\nIF state_id <> previous_state THEN\n    filling_active := (state_id = 1);\n\n    fill_timer(IN := filling_active, PT := TON_Duration);\n    pause_timer(IN := filling_active, PT := TOF_Duration);\n\n    ton_q := fill_timer.Q;\n    tof_q := pause_timer.Q;\nEND_IF;\n\n(* Continuous actions of the resulting GRAFCET situation. *)\nfill_valve := (state_id = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable timer parameters; defaults are commissioning values. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n    start_edge : R_TRIG;\n    tank_runtime : FB_TankRuntime;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\ntank_runtime(\n    start := start_edge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := tank_runtime.fill_valve;\nDischargeValve := tank_runtime.discharge_valve;\n\nEND_PROGRAM",
