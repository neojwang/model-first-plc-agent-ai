     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TankFilling\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    SequenceState : INT := 0;\n    StartEdge : R_TRIG;\n    FillingTON : TON;\n    FillingTOF : TOF;\n    start : BOOL;\n    stop : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    FillingActive : BOOL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\n(* Both standard timers measure filling-step activity. *)\nFillingActive := (SequenceState = 1);\nFillingTON(IN := FillingActive, PT := TON_Duration);\nFillingTOF(IN := FillingActive, PT := TOF_Duration);\n\nton_q := FillingTON.Q;\ntof_q := FillingTOF.Q;\n\n(* Evaluate at most one sequence transition per invocation. *)\nIF stop THEN\n    SequenceState := 0;\nELSE\n    CASE SequenceState OF\n        0:\n            IF start AND NOT LSH THEN\n                SequenceState := 1;\n            END_IF;\n\n        1:\n            IF LSH THEN\n                SequenceState := 0;\n            ELSIF ton_q THEN\n                SequenceState := 2;\n            END_IF;\n\n        2:\n            IF LSH THEN\n                SequenceState := 0;\n            ELSIF NOT tof_q THEN\n                SequenceState := 1;\n            END_IF;\n\n        ELSE\n            SequenceState := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (SequenceState = 1);\ndischarge_valve := FALSE;\n\n(* LSHH is monitored by the plant interface.\n   The supplied GRAFCET defines no separate LSHH transition. *)\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TankController : FB_TankFilling;\n    (* Configurable example presets; set to the required operating values. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\nEND_VAR\n\nTankController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
