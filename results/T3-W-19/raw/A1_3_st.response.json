     "type": "output_text",
     "text": "FUNCTION_BLOCK TankRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    active_state : INT := 0;\n    next_state : INT := 0;\n    filling_active : BOOL := FALSE;\n    ton_q : BOOL := FALSE;\n    tof_q : BOOL := FALSE;\n    fill_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Evaluate timers using the current GRAFCET situation. *)\nfilling_active := (active_state = 1);\n\nfill_timer(IN := filling_active, PT := TON_Duration);\npause_timer(IN := filling_active, PT := TOF_Duration);\n\nton_q := fill_timer.Q;\ntof_q := pause_timer.Q;\n\n(* Evaluate transitions from one snapshot of the active situation. *)\nnext_state := active_state;\n\nCASE active_state OF\n    0:\n        IF start AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            next_state := 1;\n        END_IF;\n\n    1:\n        IF stop OR LSH OR LSHH THEN\n            next_state := 0;\n        ELSIF ton_q AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            next_state := 2;\n        END_IF;\n\n    2:\n        IF stop OR LSH OR LSHH THEN\n            next_state := 0;\n        ELSIF NOT tof_q AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            next_state := 1;\n        END_IF;\n\nELSE\n    next_state := 0;\nEND_CASE;\n\n(* Apply the new situation to the timers immediately.\n   This resets TON on leaving filling, starts the TOF off-delay\n   on that same departure, and asserts TOF on entering filling.\n   No further transition is evaluated during this scan. *)\nIF next_state <> active_state THEN\n    active_state := next_state;\n    filling_active := (active_state = 1);\n\n    fill_timer(IN := filling_active, PT := TON_Duration);\n    pause_timer(IN := filling_active, PT := TOF_Duration);\n\n    ton_q := fill_timer.Q;\n    tof_q := pause_timer.Q;\nEND_IF;\n\nfill_valve := (active_state = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable commissioning defaults; adjust for the plant. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start_edge : R_TRIG;\n    start : BOOL := FALSE;\n    initialized : BOOL := FALSE;\n    controller : TankRuntime;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\n(* Seed the edge detector without treating a held startup button\n   as a new press. *)\nIF NOT initialized THEN\n    start := FALSE;\n    initialized := TRUE;\nELSE\n    start := start_edge.Q;\nEND_IF;\n\ncontroller(\n    start := start,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := controller.fill_valve;\nDischargeValve := controller.discharge_valve;\n\nEND_PROGRAM",
