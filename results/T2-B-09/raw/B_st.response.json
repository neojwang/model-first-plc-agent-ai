     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingTankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state : INT := 0;\n    filling_timer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\nIF stop THEN\n    state := 0;\nELSE\n    CASE state OF\n        0:\n            IF start AND NOT LSHH THEN\n                state := 1;\n            END_IF;\n\n        1:\n            IF LSHH THEN\n                state := 0;\n            END_IF;\n\n        ELSE\n            state := 0;\n    END_CASE;\nEND_IF;\n\nfilling_timer(\n    IN := (state = 1) AND NOT stop AND NOT LSHH,\n    PT := TimerDuration\n);\ntimer_done := filling_timer.Q;\n\nIF (state = 1) AND (timer_done OR LSHH) THEN\n    state := 0;\nEND_IF;\n\nfill_valve := (state = 1) AND NOT stop AND NOT LSHH;\ndischarge_valve := FALSE;\n\n(* Reset the timer immediately when the filling step is inactive. *)\nIF state = 0 THEN\n    filling_timer(IN := FALSE, PT := TimerDuration);\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TimerDuration : TIME := T#10s;\n    start_edge : R_TRIG;\n    tank_control : FillingTankControl;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\ntank_control(\n    start := start_edge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := tank_control.fill_valve;\nDischargeValve := tank_control.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
   ],
