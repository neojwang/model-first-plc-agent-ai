  {
   "type": "message",
   "id": "msg_03ca39dc5befe48d016af9aac3a3f487d0b6abd0cfdf9d2df2",
   "role": "assistant",
   "status": "completed",
   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    full_scale_value : INT;\n    Kp : REAL := 20.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\nEND_VAR\n\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nVAR CONSTANT\n    h_span : REAL := 10.0;\n    cycle_seconds : REAL := 0.02;\n    t_h : TIME := T#10s;\n\n    (* Numeric region codes avoid the reserved standard function name MID.\n       r = 0: LOW; r = 1: MID; r = 2: HIGH. *)\n    region_low : INT := 0;\n    region_middle : INT := 1;\n    region_high : INT := 2;\nEND_VAR\n\nVAR\n    start_edge : R_TRIG;\n    hold_timer : TON;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT := 0;\n\n    control_state : INT := 0;\n    h : REAL;\n    h_target : REAL;\n    h_sp : REAL;\n    h_max : REAL;\n    eps : REAL;\n    e : REAL;\n\n    previous_error : REAL := 0.0;\n    integral_term : REAL := 0.0;\n    proportional_term : REAL;\n    derivative_term : REAL;\n    integral_increment : REAL;\n    candidate_integral : REAL;\n    candidate_output : REAL;\n    pid_output : REAL;\n    output_clamped : BOOL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\nh_target := 0.8 * h_span;\nh_sp := h_target;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nIF full_scale_value > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span\n         / INT_TO_REAL(full_scale_value);\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := region_low;\nELSIF h < h_max THEN\n    r := region_middle;\nELSE\n    r := region_high;\nEND_IF;\n\nFillValve := 0;\nDischargeValve := 0;\nfill_valve := FALSE;\ndischarge_valve := FALSE;\n\nIF stop THEN\n    control_state := 0;\nEND_IF;\n\nIF control_state = 0 THEN\n    integral_term := 0.0;\n    previous_error := e;\n\n    IF start AND NOT stop AND (full_scale_value > 0) THEN\n        control_state := 1;\n    END_IF;\nEND_IF;\n\nhold_timer(\n    IN := (control_state = 1)\n          AND NOT stop\n          AND (r <> region_high)\n          AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := hold_timer.Q;\n\nIF control_state = 1 THEN\n    IF stop OR settled OR (r = region_high)\n       OR (full_scale_value <= 0) THEN\n        control_state := 0;\n        integral_term := 0.0;\n        previous_error := e;\n    ELSE\n        proportional_term := Kp * e;\n\n        derivative_term := 0.0;\n        IF Td > 0.0 THEN\n            derivative_term := Kp * Td\n                               * (e - previous_error)\n                               / cycle_seconds;\n        END_IF;\n\n        integral_increment := 0.0;\n        IF Ti > 0.0 THEN\n            integral_increment := Kp * e * cycle_seconds / Ti;\n        END_IF;\n\n        candidate_integral := integral_term + integral_increment;\n        candidate_output := proportional_term\n                            + candidate_integral\n                            + derivative_term;\n\n        (* Suspend integration whenever the candidate output saturates. *)\n        output_clamped := (candidate_output < 0.0)\n                          OR (candidate_output > 100.0);\n\n        IF NOT output_clamped THEN\n            integral_term := candidate_integral;\n        END_IF;\n\n        pid_output := proportional_term\n                      + integral_term\n                      + derivative_term;\n\n        IF pid_output > 100.0 THEN\n            pid_output := 100.0;\n        ELSIF pid_output < 0.0 THEN\n            pid_output := 0.0;\n        END_IF;\n\n        previous_error := e;\n\n        fill_valve := TRUE;\n        discharge_valve := TRUE;\n\n        FillValve := REAL_TO_INT(\n            pid_output * INT_TO_REAL(full_scale_value) / 100.0\n        );\n        DischargeValve := REAL_TO_INT(\n            0.4 * INT_TO_REAL(full_scale_value)\n        );\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\n\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\nEND_VAR\n\nVAR\n    controller : LevelControl;\n    Kp : REAL := 20.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\nEND_VAR\n\ncontroller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    full_scale_value := FULL_SCALE,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td\n);\n\nFillValve := controller.FillValve;\nDischargeValve := controller.DischargeValve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\nRESOURCE Res0 ON PLC\n    TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n    PROGRAM MainInstance WITH ControlTask : Main;\nEND_RESOURCE\nEND_CONFIGURATION",
