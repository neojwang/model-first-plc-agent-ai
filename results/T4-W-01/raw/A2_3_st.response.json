     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    Kp : REAL := 2.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    CycleSeconds : REAL := 0.02;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    h_target : REAL := 0.8;\n    h_max : REAL := 0.9;\n    eps : REAL := 0.02;\n    t_h : TIME := T#10s;\n    REGION_LOW : INT := 0;\n    REGION_MID : INT := 1;\n    REGION_HIGH : INT := 2;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT;\n    StateNumber : INT := 0;\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    WasRegulating : BOOL := FALSE;\n    h : REAL;\n    ErrorValue : REAL;\n    PreviousError : REAL := 0.0;\n    IntegralTerm : REAL := 0.0;\n    DerivativeTerm : REAL := 0.0;\n    RawDemand : REAL;\n    BoundedDemand : REAL;\n    SampleSeconds : REAL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nh := INT_TO_REAL(LevelMeter) / INT_TO_REAL(FULL_SCALE);\nErrorValue := h_target - h;\n\nIF h < h_target THEN\n    r := REGION_LOW;\nELSIF h < h_max THEN\n    r := REGION_MID;\nELSE\n    r := REGION_HIGH;\nEND_IF;\n\n(* CycleSeconds must match the actual periodic invocation interval. *)\nSampleSeconds := CycleSeconds;\nIF SampleSeconds <= 0.0 THEN\n    SampleSeconds := 0.02;\nEND_IF;\n\nHoldTimer(\n    IN := (StateNumber = 1)\n          AND NOT stop\n          AND (ABS(ErrorValue) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nIF stop THEN\n    StateNumber := 0;\nELSE\n    CASE StateNumber OF\n        0:\n            IF start THEN\n                StateNumber := 1;\n            END_IF;\n        1:\n            IF settled OR (r = REGION_HIGH) THEN\n                StateNumber := 0;\n            END_IF;\n    ELSE\n        StateNumber := 0;\n    END_CASE;\nEND_IF;\n\n(* An already-high level must not produce a valve-opening pulse. *)\nIF r = REGION_HIGH THEN\n    StateNumber := 0;\nEND_IF;\n\nx0 := StateNumber = 0;\nx1 := StateNumber = 1;\n\nfill_valve := x1;\ndischarge_valve := x1;\n\nFillValve := 0;\nDischargeValve := 0;\n\nIF x1 THEN\n    IF NOT WasRegulating THEN\n        IntegralTerm := 0.0;\n        PreviousError := ErrorValue;\n    END_IF;\n\n    DerivativeTerm :=\n        Kp * Td * (ErrorValue - PreviousError) / SampleSeconds;\n\n    (* Demand is expressed as a fraction of full valve opening. *)\n    RawDemand := Kp * ErrorValue + IntegralTerm + DerivativeTerm;\n\n    IF RawDemand > 1.0 THEN\n        BoundedDemand := 1.0;\n    ELSIF RawDemand < 0.0 THEN\n        BoundedDemand := 0.0;\n    ELSE\n        BoundedDemand := RawDemand;\n    END_IF;\n\n    (* Update the integral for the next sample only when unclamped.\n       Ti <= 0 disables integral action. *)\n    IF Ti > 0.0 THEN\n        IF (RawDemand > 0.0) AND (RawDemand < 1.0) THEN\n            IntegralTerm :=\n                IntegralTerm\n                + Kp * ErrorValue * SampleSeconds / Ti;\n        END_IF;\n    ELSE\n        IntegralTerm := 0.0;\n    END_IF;\n\n    PreviousError := ErrorValue;\n\n    FillValve :=\n        REAL_TO_INT(BoundedDemand * INT_TO_REAL(FULL_SCALE));\n    DischargeValve :=\n        REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\nELSE\n    IntegralTerm := 0.0;\n    DerivativeTerm := 0.0;\n    PreviousError := ErrorValue;\n    RawDemand := 0.0;\n    BoundedDemand := 0.0;\nEND_IF;\n\nWasRegulating := x1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR\n    LevelController : FB_LevelControl;\n    Kp : REAL := 2.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    CycleSeconds : REAL := 0.02;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nLevelController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    CycleSeconds := CycleSeconds\n);\n\nFillValve := LevelController.FillValve;\nDischargeValve := LevelController.DischargeValve;\nfill_valve := LevelController.fill_valve;\ndischarge_valve := LevelController.discharge_valve;\n\nEND_PROGRAM",
