     "text": "FUNCTION_BLOCK ConveyorRuntime\nVAR_INPUT\n    sensor_a : BOOL;\n    sensor_b : BOOL;\n    initialize : BOOL;\nEND_VAR\nVAR_OUTPUT\n    conveyor : BOOL;\nEND_VAR\nVAR\n    command_latch : RS;\nEND_VAR\n\nIF initialize THEN\n    command_latch(S := FALSE, R1 := TRUE);\nEND_IF;\n\ncommand_latch(\n    S := sensor_a AND NOT sensor_b,\n    R1 := sensor_b\n);\n\nconveyor := command_latch.Q1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    SensorA AT %IX100.0 : BOOL;\n    SensorB AT %IX100.1 : BOOL;\n    Conveyor AT %QX100.0 : BOOL;\nEND_VAR\nVAR\n    runtime : ConveyorRuntime;\n    first_scan : BOOL := TRUE;\nEND_VAR\n\nruntime(\n    sensor_a := SensorA,\n    sensor_b := SensorB,\n    initialize := first_scan\n);\n\nConveyor := runtime.conveyor;\nfirst_scan := FALSE;\n\nEND_PROGRAM",
