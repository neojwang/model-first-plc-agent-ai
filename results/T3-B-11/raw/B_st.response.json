   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK TankRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_number : INT := 0;\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    filling_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Timer inputs follow the activity of the filling step. *)\nfilling_active := (state_number = 1);\n\nfilling_timer(\n    IN := filling_active,\n    PT := TON_Duration\n);\nton_q := filling_timer.Q;\n\npause_timer(\n    IN := filling_active,\n    PT := TOF_Duration\n);\ntof_q := pause_timer.Q;\n\n(* Stop and level switches override every operating state.\n   LSHH is an additional shutdown interlock. *)\nIF stop OR LSH OR LSHH THEN\n    state_number := 0;\nELSE\n    CASE state_number OF\n        0:\n            IF start THEN\n                state_number := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                state_number := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                state_number := 1;\n            END_IF;\n\n        ELSE\n            state_number := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (state_number = 1)\n              AND NOT stop\n              AND NOT LSH\n              AND NOT LSHH;\n\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable timing parameters; initial defaults shown. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#2s;\n\n    start : BOOL;\n    stop : BOOL;\n    start_edge : R_TRIG;\n    controller : TankRuntime;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\ncontroller(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := controller.fill_valve;\nDischargeValve := controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
