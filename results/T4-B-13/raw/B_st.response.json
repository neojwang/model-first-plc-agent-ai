   "status": "completed",
   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    (* Region encoding: 0 = LOW, 1 = MID, 2 = HIGH. *)\n    r : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nVAR CONSTANT\n    h_span : REAL := 10.0;\n    sample_seconds : REAL := 0.02;\n    t_h : TIME := T#10s;\nEND_VAR\n\nVAR\n    start_edge : R_TRIG;\n    hold_timer : TON;\n    control_state : INT := 0;\n\n    h : REAL;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    e : REAL;\n\n    integral_term : REAL := 0.0;\n    proposed_integral : REAL;\n    previous_error : REAL := 0.0;\n    proportional_term : REAL;\n    derivative_term : REAL;\n    raw_output : REAL;\n    bounded_output : REAL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\nh_sp := 0.8 * h_span;\nh_target := h_sp;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nIF FULL_SCALE > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := 0; (* LOW *)\nELSIF h < h_max THEN\n    r := 1; (* MID *)\nELSE\n    r := 2; (* HIGH *)\nEND_IF;\n\nIF stop THEN\n    control_state := 0;\nELSIF (control_state = 0) AND start THEN\n    control_state := 1;\n    integral_term := 0.0;\n    previous_error := e;\nEND_IF;\n\nhold_timer(\n    IN := (control_state = 1) AND NOT stop AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := hold_timer.Q;\n\nFillValve := 0;\nDischargeValve := 0;\nfill_valve := FALSE;\ndischarge_valve := FALSE;\n\nCASE control_state OF\n    0:\n        integral_term := 0.0;\n        previous_error := e;\n\n    1:\n        IF stop OR settled OR (r = 2) OR (FULL_SCALE <= 0) THEN\n            control_state := 0;\n            integral_term := 0.0;\n            previous_error := e;\n        ELSE\n            proportional_term := Kp * e;\n            derivative_term :=\n                Kp * Td * (e - previous_error) / sample_seconds;\n\n            IF Ti > 0.0 THEN\n                proposed_integral :=\n                    integral_term + Kp * e * sample_seconds / Ti;\n            ELSE\n                integral_term := 0.0;\n                proposed_integral := 0.0;\n            END_IF;\n\n            raw_output :=\n                proportional_term + proposed_integral + derivative_term;\n\n            (* Freeze the integral whenever the proposed output is clamped. *)\n            IF raw_output > 1.0 THEN\n                bounded_output := 1.0;\n            ELSIF raw_output < 0.0 THEN\n                bounded_output := 0.0;\n            ELSE\n                bounded_output := raw_output;\n                integral_term := proposed_integral;\n            END_IF;\n\n            previous_error := e;\n\n            fill_valve := TRUE;\n            discharge_valve := TRUE;\n            FillValve :=\n                REAL_TO_INT(bounded_output * INT_TO_REAL(FULL_SCALE));\n            DischargeValve :=\n                REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\n        END_IF;\n\nELSE\n    control_state := 0;\n    integral_term := 0.0;\n    previous_error := e;\nEND_CASE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\n\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\nEND_VAR\n\nVAR\n    (* Initial tuning: output fraction per volt; Ti and Td are in seconds. *)\n    Kp : REAL := 0.25;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\n\n    controller : LevelControl;\nEND_VAR\n\ncontroller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td\n);\n\nFillValve := controller.FillValve;\nDischargeValve := controller.DischargeValve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
