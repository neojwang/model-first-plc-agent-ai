     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingTankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL := FALSE;\n    discharge_valve : BOOL := FALSE;\nEND_VAR\nVAR\n    current_state : INT := 0;\n    filling_active : BOOL := FALSE;\n    fill_timer : TON;\n    pause_timer : TOF;\n    ton_q : BOOL := FALSE;\n    tof_q : BOOL := FALSE;\nEND_VAR\n\n(* States: 0 = idle, 1 = filling, 2 = pause. *)\nIF stop OR LSH OR LSHH THEN\n    current_state := 0;\nEND_IF;\n\nfilling_active := (current_state = 1);\n\nfill_timer(\n    IN := filling_active,\n    PT := TON_Duration\n);\nton_q := fill_timer.Q;\n\npause_timer(\n    IN := filling_active,\n    PT := TOF_Duration\n);\ntof_q := pause_timer.Q;\n\nIF stop OR LSH OR LSHH THEN\n    current_state := 0;\nELSE\n    CASE current_state OF\n        0:\n            IF start THEN\n                current_state := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                current_state := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                current_state := 1;\n            END_IF;\n\n        ELSE\n            current_state := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (current_state = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable phase durations. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start_edge : R_TRIG;\n    tank_control : FillingTankControl;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\ntank_control(\n    start := start_edge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := tank_control.fill_valve;\nDischargeValve := tank_control.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
