     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TankFilling\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    cycle_state : INT := 0;\n    start_edge : R_TRIG;\n    filling_timer : TON;\n    pause_timer : TOF;\n    start : BOOL;\n    stop : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    filling_active : BOOL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\n(* Both timers measure the activity of the filling step. *)\nfilling_active := (cycle_state = 1);\nfilling_timer(IN := filling_active, PT := TON_Duration);\npause_timer(IN := filling_active, PT := TOF_Duration);\n\nton_q := filling_timer.Q;\ntof_q := pause_timer.Q;\n\n(* Stop has priority over all normal transitions. *)\nIF stop THEN\n    cycle_state := 0;\nELSE\n    CASE cycle_state OF\n        0:\n            IF start AND NOT LSH THEN\n                cycle_state := 1;\n            END_IF;\n\n        1:\n            IF LSH THEN\n                cycle_state := 0;\n            ELSIF ton_q THEN\n                cycle_state := 2;\n            END_IF;\n\n        2:\n            IF LSH THEN\n                cycle_state := 0;\n            ELSIF NOT tof_q THEN\n                cycle_state := 1;\n            END_IF;\n\n        ELSE\n            cycle_state := 0;\n    END_CASE;\nEND_IF;\n\n(* LSHH is monitored by the plant; no additional transition is specified. *)\nfill_valve := (cycle_state = 1) AND NOT stop;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    tank_controller : FB_TankFilling;\n    (* Example presets; configure these for the required cycle timing. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#3s;\nEND_VAR\n\ntank_controller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := tank_controller.fill_valve;\nDischargeValve := tank_controller.discharge_valve;\n\nEND_PROGRAM",
