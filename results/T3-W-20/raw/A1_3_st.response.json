     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    x2 : BOOL := FALSE;\n    t1 : BOOL;\n    t2 : BOOL;\n    t3 : BOOL;\n    t4 : BOOL;\n    t5 : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    FillingTimer : TON;\n    PauseTimer : TOF;\nEND_VAR\n\n(* Both timers are evaluated every scan using filling-step activity. *)\nFillingTimer(IN := x1, PT := TON_Duration);\nPauseTimer(IN := x1, PT := TOF_Duration);\n\nton_q := FillingTimer.Q;\ntof_q := PauseTimer.Q;\n\n(* Evaluate all transitions against the same current situation. *)\nt1 := x0 AND start AND NOT stop AND NOT LSH AND NOT LSHH;\nt2 := x1 AND ton_q AND NOT stop AND NOT LSH AND NOT LSHH;\nt3 := x2 AND NOT tof_q AND NOT stop AND NOT LSH AND NOT LSHH;\nt4 := x1 AND (stop OR LSH OR LSHH);\nt5 := x2 AND (stop OR LSH OR LSHH);\n\n(* Apply the simultaneous situation update. *)\nx0 := (x0 AND NOT t1) OR t4 OR t5;\nx1 := (x1 AND NOT (t2 OR t4)) OR t1 OR t3;\nx2 := (x2 AND NOT (t3 OR t5)) OR t2;\n\n(* Continuous, non-stored actions. *)\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable example presets; set to the required process values. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n    StartEdge : R_TRIG;\n    Controller : FillingRuntime;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
