  {
   "type": "message",
   "id": "msg_04cb31b81b1f1bc0016af9fff6ff1087d0bc3288a8bdfc3d77",
   "role": "assistant",
   "status": "completed",
   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    h_span : REAL;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    t_h : TIME;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\n    CycleSeconds : REAL;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n\n    (* Level region encoding: 0 = LOW, 1 = MID, 2 = HIGH.\n       MID is a standard function name, so it is not declared. *)\n    r : INT;\n\n    StateNumber : INT := 0;\n    h : REAL;\n    e : REAL;\n    PreviousError : REAL := 0.0;\n    IntegralTerm : REAL := 0.0;\n    DerivativeTerm : REAL;\n    RawOutput : REAL;\n    LimitedOutput : REAL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nh := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := 0;\nELSIF h < h_max THEN\n    r := 1;\nELSE\n    r := 2;\nEND_IF;\n\nHoldTimer(\n    IN := (StateNumber = 1) AND NOT stop\n          AND (r <> 2) AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\n(* Safe defaults apply to the idle state and every stopping condition. *)\nFillValve := 0;\nDischargeValve := 0;\nfill_valve := FALSE;\ndischarge_valve := FALSE;\n\nIF stop THEN\n    StateNumber := 0;\n    IntegralTerm := 0.0;\n    PreviousError := e;\nELSE\n    CASE StateNumber OF\n        0:\n            IntegralTerm := 0.0;\n            PreviousError := e;\n\n            IF start AND (r <> 2) THEN\n                StateNumber := 1;\n            END_IF;\n\n        1:\n            IF settled OR (r = 2) THEN\n                StateNumber := 0;\n                IntegralTerm := 0.0;\n                PreviousError := e;\n            ELSE\n                DerivativeTerm := 0.0;\n                IF CycleSeconds > 0.0 THEN\n                    DerivativeTerm :=\n                        Kp * Td * (e - PreviousError) / CycleSeconds;\n                END_IF;\n\n                RawOutput := Kp * e + IntegralTerm + DerivativeTerm;\n\n                IF RawOutput > 100.0 THEN\n                    LimitedOutput := 100.0;\n                ELSIF RawOutput < 0.0 THEN\n                    LimitedOutput := 0.0;\n                ELSE\n                    LimitedOutput := RawOutput;\n                END_IF;\n\n                (* Conditional integration: freeze the integrator while\n                   the controller output is at either saturation limit.\n                   The updated integral is used on the next scan. *)\n                IF (RawOutput > 0.0) AND (RawOutput < 100.0)\n                   AND (Ti > 0.0) AND (CycleSeconds > 0.0) THEN\n                    IntegralTerm :=\n                        IntegralTerm + Kp * e * CycleSeconds / Ti;\n                END_IF;\n\n                PreviousError := e;\n\n                fill_valve := TRUE;\n                discharge_valve := TRUE;\n                FillValve := REAL_TO_INT(\n                    LimitedOutput * INT_TO_REAL(FULL_SCALE) / 100.0\n                );\n                DischargeValve := REAL_TO_INT(\n                    0.4 * INT_TO_REAL(FULL_SCALE)\n                );\n            END_IF;\n\n        ELSE\n            StateNumber := 0;\n            IntegralTerm := 0.0;\n            PreviousError := e;\n    END_CASE;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    h_span : REAL := 10.0;\n    h_sp : REAL := 8.0;\n    h_target : REAL := 8.0;\n    h_max : REAL := 9.0;\n    eps : REAL := 0.2;\n    t_h : TIME := T#10s;\n    CycleSeconds : REAL := 0.02;\nEND_VAR\nVAR\n    (* Initial tuning values; adjust for the simulated plant.\n       Kp is percent valve opening per volt; Ti and Td are seconds. *)\n    Kp : REAL := 25.0;\n    Ti : REAL := 20.0;\n    Td : REAL := 0.0;\n    Controller : LevelControl;\nEND_VAR\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    h_sp := h_sp,\n    h_target := h_target,\n    h_max := h_max,\n    eps := eps,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    CycleSeconds := CycleSeconds\n);\n\nFillValve := Controller.FillValve;\nDischargeValve := Controller.DischargeValve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
