     "type": "output_text",
     "text": "FUNCTION_BLOCK TankFillingControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    current_state : INT := 0; (* 0: idle, 1: filling, 2: pause *)\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    FillingTON : TON;\n    FillingTOF : TOF;\nEND_VAR\n\nfilling_active := (current_state = 1)\n                  AND NOT stop\n                  AND NOT LSH\n                  AND NOT LSHH;\n\nFillingTON(IN := filling_active, PT := TON_Duration);\nFillingTOF(IN := filling_active, PT := TOF_Duration);\n\nton_q := FillingTON.Q;\ntof_q := FillingTOF.Q;\n\n(* Stop and both level switches override all sequence transitions. *)\nIF stop OR LSH OR LSHH THEN\n    current_state := 0;\nELSE\n    CASE current_state OF\n        0:\n            IF start THEN\n                current_state := 1;\n            END_IF;\n\n        1:\n            IF ton_q AND NOT LSH THEN\n                current_state := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                current_state := 1;\n            END_IF;\n\n    ELSE\n        current_state := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (current_state = 1)\n              AND NOT stop\n              AND NOT LSH\n              AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable timer parameters. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    StartEdge : R_TRIG;\n    Controller : TankFillingControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
