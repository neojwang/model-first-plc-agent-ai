     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_number : INT := 0;\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    fill_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Time the filling step. Safety inputs immediately remove its activity. *)\nfilling_active := (state_number = 1)\n                  AND NOT stop\n                  AND NOT LSH\n                  AND NOT LSHH;\n\nfill_timer(IN := filling_active, PT := TON_Duration);\nton_q := fill_timer.Q;\n\n(* Apply safety conditions before processing normal transitions. *)\nIF stop OR LSH OR LSHH THEN\n    state_number := 0;\nELSE\n    CASE state_number OF\n        0:\n            IF start THEN\n                state_number := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                state_number := 2;\n            END_IF;\n\n        2:\n            (* The pause transition is evaluated after updating TOF. *)\n            state_number := 2;\n\n    ELSE\n        state_number := 0;\n    END_CASE;\nEND_IF;\n\n(* Update TOF after departures from filling so its off-delay starts\n   in the same scan that the fill valve closes. *)\nfilling_active := (state_number = 1)\n                  AND NOT stop\n                  AND NOT LSH\n                  AND NOT LSHH;\n\npause_timer(IN := filling_active, PT := TOF_Duration);\ntof_q := pause_timer.Q;\n\nIF (state_number = 2) AND NOT tof_q\n   AND NOT stop AND NOT LSH AND NOT LSHH THEN\n    state_number := 1;\nEND_IF;\n\nfill_valve := (state_number = 1)\n              AND NOT stop\n              AND NOT LSH\n              AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable timing parameters; adjust to suit the plant. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start : BOOL;\n    stop : BOOL;\n    start_edge : R_TRIG;\n    tank_control : FB_TankControl;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\ntank_control(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := tank_control.fill_valve;\nDischargeValve := tank_control.discharge_valve;\n\nEND_PROGRAM",
