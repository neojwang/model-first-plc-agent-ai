     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    timer_done : BOOL := FALSE;\n    filling_timer : TON;\n    enter_filling : BOOL;\n    leave_filling : BOOL;\nEND_VAR\n\n(* Evaluate the timer for the currently active step. *)\nfilling_timer(IN := x1, PT := TimerDuration);\ntimer_done := filling_timer.Q;\n\n(* Evaluate transitions from the current situation. *)\nenter_filling := x0 AND start AND NOT stop AND NOT LSHH;\nleave_filling := x1 AND (stop OR timer_done OR LSHH);\n\nIF enter_filling THEN\n    x0 := FALSE;\n    x1 := TRUE;\n\n    (* Start timing immediately upon activation of x1. *)\n    filling_timer(IN := TRUE, PT := TimerDuration);\n    timer_done := FALSE;\nELSIF leave_filling THEN\n    x1 := FALSE;\n    x0 := TRUE;\n\n    (* Reset the timer when its owning step becomes inactive. *)\n    filling_timer(IN := FALSE, PT := TimerDuration);\n    timer_done := FALSE;\nEND_IF;\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configure this parameter for the required filling interval. *)\n    TimerDuration : TIME := T#10s;\n    start_edge : R_TRIG;\n    filling_control : FillingRuntime;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\nfilling_control(\n    start := start_edge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := filling_control.fill_valve;\nDischargeValve := filling_control.discharge_valve;\n\nEND_PROGRAM",
