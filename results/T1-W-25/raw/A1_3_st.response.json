     "text": "FUNCTION_BLOCK TransferRuntime\nVAR_INPUT\n    sensor_a : BOOL;\n    sensor_b : BOOL;\n    initialize : BOOL;\nEND_VAR\nVAR_OUTPUT\n    conveyor : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    t1 : BOOL;\n    t2 : BOOL;\n    run_latch : RS;\nEND_VAR\n\nIF initialize THEN\n    x0 := TRUE;\n    x1 := FALSE;\n    run_latch(S := FALSE, R1 := TRUE);\nEND_IF;\n\nt1 := x0 AND sensor_a AND NOT sensor_b;\nt2 := x1 AND sensor_b;\n\nrun_latch(S := t1, R1 := t2);\n\nx1 := run_latch.Q1;\nx0 := NOT x1;\nconveyor := x1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    SensorA AT %IX100.0 : BOOL;\n    SensorB AT %IX100.1 : BOOL;\n    Conveyor AT %QX100.0 : BOOL;\nEND_VAR\nVAR\n    runtime_logic : TransferRuntime;\n    first_scan : BOOL := TRUE;\nEND_VAR\n\nruntime_logic(\n    sensor_a := SensorA,\n    sensor_b := SensorB,\n    initialize := first_scan\n);\n\nConveyor := runtime_logic.conveyor;\nfirst_scan := FALSE;\n\nEND_PROGRAM",
