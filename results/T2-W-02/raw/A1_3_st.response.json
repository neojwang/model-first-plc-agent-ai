     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    ActiveState : INT := 0;\n    FillingTimer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\nCASE ActiveState OF\n    0:\n        timer_done := FALSE;\n\n        IF start AND NOT stop AND NOT LSHH THEN\n            ActiveState := 1;\n        END_IF;\n\n        (* Start timing in the scan that activates x1. *)\n        FillingTimer(\n            IN := (ActiveState = 1),\n            PT := TimerDuration\n        );\n\n    1:\n        FillingTimer(IN := TRUE, PT := TimerDuration);\n        timer_done := FillingTimer.Q;\n\n        IF stop OR LSHH OR timer_done THEN\n            ActiveState := 0;\n            FillingTimer(IN := FALSE, PT := TimerDuration);\n            timer_done := FALSE;\n        END_IF;\n\nELSE\n    ActiveState := 0;\n    FillingTimer(IN := FALSE, PT := TimerDuration);\n    timer_done := FALSE;\nEND_CASE;\n\nfill_valve := (ActiveState = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable filling interval; example initial setting. *)\n    TimerDuration : TIME := T#10s;\n    StartEdge : R_TRIG;\n    Controller : FillingRuntime;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
   ],
