     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StateNumber : INT := 0;\n    FillTimer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\n(* Stop has priority over all other commands. *)\nIF stop THEN\n    StateNumber := 0;\nELSE\n    CASE StateNumber OF\n        0:\n            IF start AND NOT LSHH THEN\n                StateNumber := 1;\n            END_IF;\n\n        1:\n            StateNumber := 1;\n\n    ELSE\n        StateNumber := 0;\n    END_CASE;\nEND_IF;\n\n(* Start timing in the same scan that filling begins. *)\nFillTimer(\n    IN := (StateNumber = 1),\n    PT := TimerDuration\n);\ntimer_done := FillTimer.Q;\n\nIF (StateNumber = 1) AND (timer_done OR LSHH) THEN\n    StateNumber := 0;\n\n    (* Reset immediately so the next filling cycle gets a fresh timer. *)\n    FillTimer(IN := FALSE, PT := TimerDuration);\nEND_IF;\n\nfill_valve := (StateNumber = 1) AND NOT stop;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable filling duration; default is ten seconds. *)\n    TimerDuration : TIME := T#10s;\n    StartEdge : R_TRIG;\n    Controller : FillingControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
   ],
