     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    Kp : REAL := 10.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    h_span : REAL := 10.0;\n    t_h : TIME := T#10s;\n    cycle_seconds : REAL := 0.02;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    REGION_LOW : INT := 0;\n    REGION_MID : INT := 1;\n    REGION_HIGH : INT := 2;\nEND_VAR\nVAR\n    start_edge : R_TRIG;\n    hold_timer : TON;\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT;\n    state_id : INT := 0;\n    previous_state : INT := 0;\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    h : REAL;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    error_value : REAL;\n    previous_error : REAL := 0.0;\n    integral_value : REAL := 0.0;\n    integral_candidate : REAL;\n    proportional_value : REAL;\n    derivative_value : REAL;\n    candidate_output : REAL;\n    raw_output : REAL;\n    bounded_output : REAL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\nh := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nh_sp := 0.8 * h_span;\nh_target := h_sp;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\nerror_value := h_sp - h;\n\nIF h < h_target THEN\n    r := REGION_LOW;\nELSIF h < h_max THEN\n    r := REGION_MID;\nELSE\n    r := REGION_HIGH;\nEND_IF;\n\nhold_timer(\n    IN := (state_id = 1) AND NOT stop\n          AND (ABS(error_value) <= eps),\n    PT := t_h\n);\nsettled := hold_timer.Q;\n\nprevious_state := state_id;\n\nIF stop THEN\n    state_id := 0;\nELSE\n    CASE state_id OF\n        0:\n            IF start AND (r <> REGION_HIGH) THEN\n                state_id := 1;\n            END_IF;\n        1:\n            IF settled OR (r = REGION_HIGH) THEN\n                state_id := 0;\n            END_IF;\n    ELSE\n        state_id := 0;\n    END_CASE;\nEND_IF;\n\nx0 := state_id = 0;\nx1 := state_id = 1;\n\nfill_valve := x1;\ndischarge_valve := x1;\n\nFillValve := 0;\nDischargeValve := 0;\n\nIF x1 THEN\n    IF previous_state <> 1 THEN\n        previous_error := error_value;\n    END_IF;\n\n    proportional_value := Kp * error_value;\n\n    derivative_value := 0.0;\n    IF (cycle_seconds > 0.0) AND (Td > 0.0) THEN\n        derivative_value :=\n            Kp * Td * (error_value - previous_error) / cycle_seconds;\n    END_IF;\n\n    raw_output :=\n        proportional_value + integral_value + derivative_value;\n\n    (* Freeze integration whenever the current PID demand is clamped.\n       Also reject an integration update that would cross either limit. *)\n    IF (raw_output >= 0.0) AND (raw_output <= 100.0) THEN\n        integral_candidate := integral_value;\n\n        IF (Ti > 0.0) AND (cycle_seconds > 0.0) THEN\n            integral_candidate :=\n                integral_value + Kp * error_value * cycle_seconds / Ti;\n        END_IF;\n\n        candidate_output :=\n            proportional_value + integral_candidate + derivative_value;\n\n        IF (candidate_output >= 0.0) AND (candidate_output <= 100.0) THEN\n            integral_value := integral_candidate;\n            raw_output := candidate_output;\n        END_IF;\n    END_IF;\n\n    IF raw_output < 0.0 THEN\n        bounded_output := 0.0;\n    ELSIF raw_output > 100.0 THEN\n        bounded_output := 100.0;\n    ELSE\n        bounded_output := raw_output;\n    END_IF;\n\n    FillValve :=\n        REAL_TO_INT(bounded_output * INT_TO_REAL(FULL_SCALE) / 100.0);\n    DischargeValve :=\n        REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\n\n    previous_error := error_value;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR\n    controller : FB_LevelControl;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\n    (* Commissioning defaults; tune gains for the simulated tank.\n       PID demand is in percent and level error is in volts. *)\n    Kp : REAL := 10.0;\n    Ti : REAL := 10.0;\n    Td : REAL := 0.0;\n    h_span : REAL := 10.0;\n    t_h : TIME := T#10s;\n    cycle_seconds : REAL := 0.02;\nEND_VAR\n\ncontroller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    h_span := h_span,\n    t_h := t_h,\n    cycle_seconds := cycle_seconds\n);\n\nFillValve := controller.FillValve;\nDischargeValve := controller.DischargeValve;\nfill_valve := controller.fill_valve;\ndischarge_valve := controller.discharge_valve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\nRESOURCE Res0 ON PLC\n    TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n    PROGRAM MainInstance WITH ControlTask : Main;\nEND_RESOURCE\nEND_CONFIGURATION",
