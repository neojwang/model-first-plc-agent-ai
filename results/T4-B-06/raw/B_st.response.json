  {
   "type": "message",
   "id": "msg_0173abb71d1b7250016af9ab843f5c87d091b204d3d71683a4",
   "role": "assistant",
   "status": "completed",
   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    h_span : REAL;\n    h_target : REAL;\n    h_sp : REAL;\n    h_max : REAL;\n    eps : REAL;\n    t_h : TIME;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\n    sample_seconds : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT;\n\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\n\nVAR CONSTANT\n    (* Region encodings avoid reserved identifiers such as MID. *)\n    REGION_LOW : INT := 0;\n    REGION_MID : INT := 1;\n    REGION_HIGH : INT := 2;\nEND_VAR\n\nVAR\n    start_edge : R_TRIG;\n    hold_timer : TON;\n\n    control_state : INT := 0;\n    h : REAL;\n    e : REAL;\n    previous_error : REAL := 0.0;\n    integral_term : REAL := 0.0;\n    proportional_term : REAL;\n    derivative_term : REAL;\n    integral_increment : REAL;\n    candidate_output : REAL;\n    raw_output : REAL;\n    output_percent : REAL;\n    scale_real : REAL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\nscale_real := INT_TO_REAL(FULL_SCALE);\n\nIF FULL_SCALE > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span / scale_real;\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := REGION_LOW;\nELSIF h < h_max THEN\n    r := REGION_MID;\nELSE\n    r := REGION_HIGH;\nEND_IF;\n\n(* Stop has priority over a simultaneous start event. *)\nIF stop THEN\n    control_state := 0;\nEND_IF;\n\nCASE control_state OF\n    0:\n        IF start AND NOT stop THEN\n            integral_term := 0.0;\n            previous_error := e;\n            control_state := 1;\n        END_IF;\n\n    1:\n        IF stop THEN\n            control_state := 0;\n        END_IF;\n\nELSE\n    control_state := 0;\nEND_CASE;\n\nhold_timer(\n    IN := (control_state = 1)\n          AND NOT stop\n          AND (r <> REGION_HIGH)\n          AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := hold_timer.Q;\n\nIF (control_state = 1)\n   AND (settled OR (r = REGION_HIGH) OR stop) THEN\n    control_state := 0;\nEND_IF;\n\nFillValve := 0;\nDischargeValve := 0;\nfill_valve := FALSE;\ndischarge_valve := FALSE;\n\nIF control_state = 1 THEN\n    fill_valve := TRUE;\n    discharge_valve := TRUE;\n\n    (* PID terms are expressed in percent valve opening.\n       Kp has units percent per level unit; Ti and Td use seconds. *)\n    proportional_term := Kp * e;\n\n    derivative_term := 0.0;\n    IF (Td > 0.0) AND (sample_seconds > 0.0) THEN\n        derivative_term :=\n            Kp * Td * (e - previous_error) / sample_seconds;\n    END_IF;\n\n    IF Ti <= 0.0 THEN\n        integral_term := 0.0;\n    END_IF;\n\n    raw_output :=\n        proportional_term + integral_term + derivative_term;\n\n    (* Freeze integration whenever the output is clamped.\n       Also reject an integration increment that would cause clamping. *)\n    IF (Ti > 0.0)\n       AND (sample_seconds > 0.0)\n       AND (raw_output >= 0.0)\n       AND (raw_output <= 100.0) THEN\n\n        integral_increment := Kp * e * sample_seconds / Ti;\n        candidate_output := raw_output + integral_increment;\n\n        IF (candidate_output >= 0.0)\n           AND (candidate_output <= 100.0) THEN\n            integral_term := integral_term + integral_increment;\n            raw_output := candidate_output;\n        END_IF;\n    END_IF;\n\n    IF raw_output < 0.0 THEN\n        output_percent := 0.0;\n    ELSIF raw_output > 100.0 THEN\n        output_percent := 100.0;\n    ELSE\n        output_percent := raw_output;\n    END_IF;\n\n    IF FULL_SCALE > 0 THEN\n        FillValve :=\n            REAL_TO_INT(output_percent * scale_real / 100.0);\n        DischargeValve := REAL_TO_INT(0.4 * scale_real);\n    END_IF;\n\n    previous_error := e;\nELSE\n    integral_term := 0.0;\n    previous_error := e;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\n\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    CYCLE_SECONDS : REAL := 0.02;\nEND_VAR\n\nVAR\n    controller : LevelControl;\n\n    h_span : REAL := 10.0;\n    h_target : REAL := 8.0;\n    h_sp : REAL := 8.0;\n    h_max : REAL := 9.0;\n    eps : REAL := 0.2;\n    t_h : TIME := T#10s;\n\n    (* Initial tuning values; adjust to the actual plant. *)\n    Kp : REAL := 30.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\nEND_VAR\n\nh_target := 0.8 * h_span;\nh_sp := h_target;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\ncontroller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    h_target := h_target,\n    h_sp := h_sp,\n    h_max := h_max,\n    eps := eps,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    sample_seconds := CYCLE_SECONDS\n);\n\nFillValve := controller.FillValve;\nDischargeValve := controller.DischargeValve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
     "annotations": [],
     "logprobs": []
    }
