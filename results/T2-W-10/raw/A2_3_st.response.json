     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TimedTankFilling\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    FillTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    timer_done : BOOL;\n    CurrentState : INT := 0;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nIF stop THEN\n    CurrentState := 0;\nELSE\n    CASE CurrentState OF\n        0:\n            IF start AND NOT LSHH THEN\n                CurrentState := 1;\n            END_IF;\n\n        1:\n            IF LSHH THEN\n                CurrentState := 0;\n            END_IF;\n\n        ELSE\n            CurrentState := 0;\n    END_CASE;\nEND_IF;\n\nFillTimer(IN := (CurrentState = 1), PT := TimerDuration);\ntimer_done := FillTimer.Q;\n\nIF (CurrentState = 1) AND timer_done THEN\n    CurrentState := 0;\nEND_IF;\n\nIF CurrentState = 0 THEN\n    FillTimer(IN := FALSE, PT := TimerDuration);\n    timer_done := FALSE;\nEND_IF;\n\nfill_valve := (CurrentState = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TimerDuration : TIME := T#10s;\n    TankController : FB_TimedTankFilling;\nEND_VAR\n\nTankController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
