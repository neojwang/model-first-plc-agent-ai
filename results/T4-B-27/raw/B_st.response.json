     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    FULL_SCALE : INT;\n    h_span : REAL;\n    t_h : TIME;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\nEND_VAR\nVAR_OUTPUT\n    FillDemand : INT;\n    DischargeDemand : INT;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n\n    (* Region encoding: 0 = LOW, 1 = MID, 2 = HIGH.\n       Numeric values avoid using the standard function name MID. *)\n    r : INT;\n\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    start_edge : R_TRIG;\n    hold_timer : TON;\n    sample_timer : TON;\n\n    state_no : INT := 0;\n    entering : BOOL;\n    update_pid : BOOL;\n\n    h : REAL;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    e : REAL;\n\n    integral_term : REAL := 0.0;\n    candidate_integral : REAL;\n    derivative_term : REAL;\n    previous_error : REAL := 0.0;\n    unconstrained_output : REAL;\n    pid_output : REAL := 0.0;\n    elapsed_seconds : REAL;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\nh_target := 0.8 * h_span;\nh_sp := h_target;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nIF FULL_SCALE > 0 THEN\n    h := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nELSE\n    h := 0.0;\nEND_IF;\n\ne := h_sp - h;\n\nIF h < h_target THEN\n    r := 0;\nELSIF h < h_max THEN\n    r := 1;\nELSE\n    r := 2;\nEND_IF;\n\nentering := FALSE;\n\nIF stop THEN\n    state_no := 0;\nELSIF (state_no = 0) AND start THEN\n    state_no := 1;\n    entering := TRUE;\n    integral_term := 0.0;\n    previous_error := e;\n    pid_output := 0.0;\nEND_IF;\n\nhold_timer(\n    IN := (state_no = 1) AND NOT stop AND (ABS(e) <= eps),\n    PT := t_h\n);\nsettled := hold_timer.Q;\n\n(* Periodic PID updates. The TON resets for one scan after each update. *)\nsample_timer(\n    IN := (state_no = 1) AND NOT stop\n          AND NOT entering AND NOT sample_timer.Q,\n    PT := T#100ms\n);\n\nFillDemand := 0;\nDischargeDemand := 0;\nfill_valve := FALSE;\ndischarge_valve := FALSE;\nupdate_pid := FALSE;\n\nCASE state_no OF\n    0:\n        integral_term := 0.0;\n        previous_error := e;\n        pid_output := 0.0;\n\n    1:\n        IF stop OR settled OR (r = 2) THEN\n            state_no := 0;\n            integral_term := 0.0;\n            previous_error := e;\n            pid_output := 0.0;\n        ELSE\n            fill_valve := TRUE;\n            discharge_valve := TRUE;\n\n            update_pid := entering OR sample_timer.Q;\n\n            IF update_pid THEN\n                derivative_term := 0.0;\n                candidate_integral := integral_term;\n\n                IF NOT entering THEN\n                    elapsed_seconds :=\n                        TIME_TO_REAL(sample_timer.ET) / 1000.0;\n\n                    IF elapsed_seconds > 0.0 THEN\n                        IF Ti > 0.0 THEN\n                            candidate_integral :=\n                                integral_term\n                                + Kp * e * elapsed_seconds / Ti;\n                        ELSE\n                            candidate_integral := 0.0;\n                        END_IF;\n\n                        IF Td > 0.0 THEN\n                            derivative_term :=\n                                Kp * Td * (e - previous_error)\n                                / elapsed_seconds;\n                        END_IF;\n                    END_IF;\n                END_IF;\n\n                (* PID output is expressed in percent opening.\n                   Reject integral updates whenever the proposed\n                   output would require clamping. *)\n                unconstrained_output :=\n                    Kp * e + candidate_integral + derivative_term;\n\n                IF unconstrained_output > 100.0 THEN\n                    pid_output := 100.0;\n                ELSIF unconstrained_output < 0.0 THEN\n                    pid_output := 0.0;\n                ELSE\n                    pid_output := unconstrained_output;\n                    integral_term := candidate_integral;\n                END_IF;\n\n                previous_error := e;\n            END_IF;\n\n            IF FULL_SCALE > 0 THEN\n                FillDemand := REAL_TO_INT(\n                    pid_output * INT_TO_REAL(FULL_SCALE) / 100.0\n                );\n                DischargeDemand := REAL_TO_INT(\n                    0.4 * INT_TO_REAL(FULL_SCALE)\n                );\n\n                IF FillDemand < 0 THEN\n                    FillDemand := 0;\n                ELSIF FillDemand > FULL_SCALE THEN\n                    FillDemand := FULL_SCALE;\n                END_IF;\n            END_IF;\n        END_IF;\n\nELSE\n    state_no := 0;\n    integral_term := 0.0;\n    previous_error := e;\n    pid_output := 0.0;\nEND_CASE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\nEND_VAR\nVAR\n    controller : LevelControl;\n\n    h_span : REAL := 10.0;\n    t_h : TIME := T#10s;\n\n    (* Kp: percent opening per volt.\n       Ti and Td: seconds. Tune these values for the plant. *)\n    Kp : REAL := 20.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\nEND_VAR\n\ncontroller(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    FULL_SCALE := FULL_SCALE,\n    h_span := h_span,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td\n);\n\nFillValve := controller.FillDemand;\nDischargeValve := controller.DischargeDemand;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
