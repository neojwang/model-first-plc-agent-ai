     "type": "output_text",
     "text": "FUNCTION_BLOCK TankRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    PhaseIndex : INT := 0;\n    FillingActive : BOOL;\n    FillLimitTimer : TON;\n    FillPauseTimer : TOF;\n    ton_q : BOOL;\n    tof_q : BOOL;\nEND_VAR\n\n(* Stop and level switches have priority over the sequence. *)\nIF stop OR LSH OR LSHH THEN\n    PhaseIndex := 0;\nEND_IF;\n\nFillingActive := (PhaseIndex = 1);\n\nFillLimitTimer(\n    IN := FillingActive,\n    PT := TON_Duration\n);\nton_q := FillLimitTimer.Q;\n\nFillPauseTimer(\n    IN := FillingActive,\n    PT := TOF_Duration\n);\ntof_q := FillPauseTimer.Q;\n\nIF NOT (stop OR LSH OR LSHH) THEN\n    CASE PhaseIndex OF\n        0:\n            IF start THEN\n                PhaseIndex := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                PhaseIndex := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                PhaseIndex := 1;\n            END_IF;\n\n    ELSE\n        PhaseIndex := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (PhaseIndex = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable timing parameters; initial values are five seconds. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    StartEdge : R_TRIG;\n    Controller : TankRuntime;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
