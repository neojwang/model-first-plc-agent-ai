     "text": "FUNCTION_BLOCK FB_TimedFilling\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    FillingTimer : TON;\n    StateIndex : INT := 0;\n    start : BOOL;\n    stop : BOOL;\n    timer_done : BOOL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nIF stop THEN\n    StateIndex := 0;\nELSE\n    CASE StateIndex OF\n        0:\n            IF start THEN\n                StateIndex := 1;\n            END_IF;\n        1:\n            StateIndex := 1;\n    ELSE\n        StateIndex := 0;\n    END_CASE;\nEND_IF;\n\nFillingTimer(\n    IN := (StateIndex = 1),\n    PT := TimerDuration\n);\ntimer_done := FillingTimer.Q;\n\nIF StateIndex = 1 THEN\n    IF stop OR timer_done OR LSHH THEN\n        StateIndex := 0;\n        FillingTimer(IN := FALSE, PT := TimerDuration);\n        timer_done := FALSE;\n    END_IF;\nEND_IF;\n\nfill_valve := (StateIndex = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    FillingController : FB_TimedFilling;\n    TimerDuration : TIME := T#10s; (* Configurable filling duration. *)\nEND_VAR\n\nFillingController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := FillingController.fill_valve;\nDischargeValve := FillingController.discharge_valve;\n\nEND_PROGRAM",
