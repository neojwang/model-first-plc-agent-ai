     "type": "output_text",
     "text": "FUNCTION_BLOCK TankRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_code : INT := 0; (* 0 = idle, 1 = filling, 2 = pause *)\n    filling_active : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\n    fill_timer : TON;\n    pause_timer : TOF;\nEND_VAR\n\n(* Call both timers every scan. *)\nfilling_active := (state_code = 1);\n\nfill_timer(IN := filling_active, PT := TON_Duration);\npause_timer(IN := filling_active, PT := TOF_Duration);\n\nton_q := fill_timer.Q;\ntof_q := pause_timer.Q;\n\n(* Stop and level interlocks take priority over all transitions. *)\nIF stop OR LSH OR LSHH THEN\n    state_code := 0;\nELSE\n    CASE state_code OF\n        0:\n            IF start THEN\n                state_code := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                state_code := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                state_code := 1;\n            END_IF;\n\n    ELSE\n        state_code := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (state_code = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable commissioning defaults. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start_edge : R_TRIG;\n    runtime : TankRuntime;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\n\nruntime(\n    start := start_edge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := runtime.fill_valve;\nDischargeValve := runtime.discharge_valve;\n\nEND_PROGRAM",
