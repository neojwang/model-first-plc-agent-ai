     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TankFilling\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    timer_done : BOOL := FALSE;\n    FillingTimer : TON;\n    t1 : BOOL;\n    t2 : BOOL;\nEND_VAR\n\n(* Evaluate the timer and transitions for the current situation. *)\nFillingTimer(IN := x1, PT := TimerDuration);\ntimer_done := FillingTimer.Q;\n\nt1 := x0 AND start AND NOT stop AND NOT LSHH;\nt2 := x1 AND (stop OR LSHH OR timer_done);\n\n(* Apply the enabled transition without cascading transitions. *)\nIF t1 THEN\n    x0 := FALSE;\n    x1 := TRUE;\n\n    (* Start timing immediately upon activation of x1. *)\n    FillingTimer(IN := TRUE, PT := TimerDuration);\n    timer_done := FALSE;\nELSIF t2 THEN\n    x0 := TRUE;\n    x1 := FALSE;\n\n    (* Reset the step-owned timer upon deactivation of x1. *)\n    FillingTimer(IN := FALSE, PT := TimerDuration);\n    timer_done := FALSE;\nEND_IF;\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable filling duration; set to the required process value. *)\n    TimerDuration : TIME := T#10s;\n    StartEdge : R_TRIG;\n    TankController : FB_TankFilling;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nTankController(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
