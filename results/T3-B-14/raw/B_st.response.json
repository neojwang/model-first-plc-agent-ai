     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingTankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    CurrentState : INT := 0;\n    FillingActive : BOOL := FALSE;\n    ton_q : BOOL := FALSE;\n    tof_q : BOOL := FALSE;\n    FillOnDelay : TON;\n    FillOffDelay : TOF;\nEND_VAR\n\n(* Stop and level switches override the filling sequence. *)\nIF stop OR LSH OR LSHH THEN\n    CurrentState := 0;\nEND_IF;\n\n(* Both timers use the activity of the filling step. *)\nFillingActive := (CurrentState = 1);\n\nFillOnDelay(\n    IN := FillingActive,\n    PT := TON_Duration\n);\nton_q := FillOnDelay.Q;\n\nFillOffDelay(\n    IN := FillingActive,\n    PT := TOF_Duration\n);\ntof_q := FillOffDelay.Q;\n\nCASE CurrentState OF\n    0:\n        IF start AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            CurrentState := 1;\n        END_IF;\n\n    1:\n        IF ton_q AND NOT LSH THEN\n            CurrentState := 2;\n        END_IF;\n\n    2:\n        IF NOT tof_q THEN\n            CurrentState := 1;\n        END_IF;\n\nELSE\n    CurrentState := 0;\nEND_CASE;\n\nfill_valve := (CurrentState = 1)\n              AND NOT stop\n              AND NOT LSH\n              AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n    StartEdge : R_TRIG;\n    TankControl : FillingTankControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nTankControl(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := TankControl.fill_valve;\nDischargeValve := TankControl.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
