     "text": "FUNCTION_BLOCK LevelControlRuntime\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    MeasuredLevel : REAL;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    t_h : TIME;\n    Kp : REAL;\n    Ti : REAL;\n    Td : REAL;\n    CycleSeconds : REAL;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL := FALSE;\n    discharge_valve : BOOL := FALSE;\n    PIDPercent : REAL := 0.0;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL := FALSE;\n\n    (* Region encoding: 0 = LOW, 1 = MID, 2 = HIGH. *)\n    r : INT := 0;\n\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    WasRegulating : BOOL := FALSE;\n\n    LevelError : REAL;\n    PreviousError : REAL := 0.0;\n    ProportionalTerm : REAL := 0.0;\n    IntegralTerm : REAL := 0.0;\n    DerivativeTerm : REAL := 0.0;\n    CandidateIntegral : REAL := 0.0;\n    CandidateDemand : REAL := 0.0;\n    UnclampedDemand : REAL := 0.0;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nLevelError := h_sp - MeasuredLevel;\n\nIF MeasuredLevel < h_target THEN\n    r := 0;\nELSIF MeasuredLevel < h_max THEN\n    r := 1;\nELSE\n    r := 2;\nEND_IF;\n\n(* Only uninterrupted time inside the tolerance band during x1 counts.\n   The timer is reset during x0, so settled is FALSE on entry to x1. *)\nHoldTimer(\n    IN := x1 AND (ABS(LevelError) <= eps) AND NOT stop,\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\n(* Evaluate transitions from the situation at the start of this scan.\n   Only one transition can fire in a scan. *)\nIF x0 THEN\n    IF start AND NOT stop AND NOT (r = 2) THEN\n        x0 := FALSE;\n        x1 := TRUE;\n    END_IF;\nELSIF x1 THEN\n    IF stop OR settled OR (r = 2) THEN\n        x1 := FALSE;\n        x0 := TRUE;\n    END_IF;\nELSE\n    x0 := TRUE;\n    x1 := FALSE;\nEND_IF;\n\nfill_valve := x1;\ndischarge_valve := x1;\n\nIF x1 THEN\n    (* Reset PID state on each new regulation run.\n       Initializing the error history prevents an entry derivative kick. *)\n    IF NOT WasRegulating THEN\n        IntegralTerm := 0.0;\n        PreviousError := LevelError;\n    END_IF;\n\n    ProportionalTerm := Kp * LevelError;\n    DerivativeTerm := 0.0;\n\n    IF (Td > 0.0) AND (CycleSeconds > 0.0) THEN\n        DerivativeTerm :=\n            Kp * Td * (LevelError - PreviousError) / CycleSeconds;\n    END_IF;\n\n    IF Ti <= 0.0 THEN\n        IntegralTerm := 0.0;\n    END_IF;\n\n    UnclampedDemand :=\n        ProportionalTerm + IntegralTerm + DerivativeTerm;\n\n    (* Conditional integration: freeze the integral when the present\n       demand is outside the limits or the proposed update would\n       put it outside the limits. *)\n    IF (Ti > 0.0) AND (CycleSeconds > 0.0) THEN\n        IF (UnclampedDemand >= 0.0)\n            AND (UnclampedDemand <= 100.0) THEN\n            CandidateIntegral :=\n                IntegralTerm + Kp * LevelError * CycleSeconds / Ti;\n            CandidateDemand :=\n                ProportionalTerm + CandidateIntegral + DerivativeTerm;\n\n            IF (CandidateDemand >= 0.0)\n                AND (CandidateDemand <= 100.0) THEN\n                IntegralTerm := CandidateIntegral;\n            END_IF;\n        END_IF;\n    END_IF;\n\n    UnclampedDemand :=\n        ProportionalTerm + IntegralTerm + DerivativeTerm;\n\n    IF UnclampedDemand > 100.0 THEN\n        PIDPercent := 100.0;\n    ELSIF UnclampedDemand < 0.0 THEN\n        PIDPercent := 0.0;\n    ELSE\n        PIDPercent := UnclampedDemand;\n    END_IF;\n\n    PreviousError := LevelError;\nELSE\n    PIDPercent := 0.0;\n    IntegralTerm := 0.0;\n    ProportionalTerm := 0.0;\n    DerivativeTerm := 0.0;\n    PreviousError := LevelError;\nEND_IF;\n\nWasRegulating := x1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\n    CycleSeconds : REAL := 0.02;\nEND_VAR\nVAR\n    Controller : LevelControlRuntime;\n\n    h_span : REAL := 10.0;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    t_h : TIME := T#10s;\n\n    (* Commissioning defaults; tune for the plant.\n       Kp: percent opening per level volt; Ti and Td: seconds. *)\n    Kp : REAL := 25.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\n\n    MeasuredLevel : REAL;\nEND_VAR\n\nh_sp := 0.8 * h_span;\nh_target := h_sp;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\n\nMeasuredLevel :=\n    INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    MeasuredLevel := MeasuredLevel,\n    h_sp := h_sp,\n    h_target := h_target,\n    h_max := h_max,\n    eps := eps,\n    t_h := t_h,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    CycleSeconds := CycleSeconds\n);\n\n(* Explicit zero defaults prevent retained analog commands in step 0. *)\nFillValve := 0;\nDischargeValve := 0;\n\nIF Controller.fill_valve THEN\n    FillValve := REAL_TO_INT(\n        Controller.PIDPercent * INT_TO_REAL(FULL_SCALE) / 100.0\n    );\nEND_IF;\n\nIF Controller.discharge_valve THEN\n    DischargeValve := REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\nEND_IF;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK MainTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH MainTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
     "annotations": [],
     "logprobs": []
    }
