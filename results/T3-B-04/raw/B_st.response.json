     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingTankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    phase : INT := 0;\n    filling_active : BOOL := FALSE;\n    ton_q : BOOL := FALSE;\n    tof_q : BOOL := FALSE;\n    FillLimitTimer : TON;\n    FillPauseTimer : TOF;\nEND_VAR\n\n(* Stop and either level switch take priority over filling. *)\nIF stop OR LSH OR LSHH THEN\n    phase := 0;\nEND_IF;\n\nfilling_active := (phase = 1);\n\nFillLimitTimer(\n    IN := filling_active,\n    PT := TON_Duration\n);\nton_q := FillLimitTimer.Q;\n\nFillPauseTimer(\n    IN := filling_active,\n    PT := TOF_Duration\n);\ntof_q := FillPauseTimer.Q;\n\nIF NOT (stop OR LSH OR LSHH) THEN\n    CASE phase OF\n        0:\n            IF start THEN\n                phase := 1;\n            END_IF;\n\n        1:\n            IF ton_q THEN\n                phase := 2;\n            END_IF;\n\n        2:\n            IF NOT tof_q THEN\n                phase := 1;\n            END_IF;\n\n        ELSE\n            phase := 0;\n    END_CASE;\nEND_IF;\n\nfill_valve := (phase = 1) AND NOT stop AND NOT LSH AND NOT LSHH;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable timer parameters; initial defaults are five seconds. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n\n    start : BOOL := FALSE;\n    stop : BOOL := FALSE;\n    StartEdge : R_TRIG;\n    TankControl : FillingTankControl;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nTankControl(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := TankControl.fill_valve;\nDischargeValve := TankControl.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
