     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TimedTankFilling\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    FillingTimer : TON;\n    start : BOOL;\n    stop : BOOL;\n    timer_done : BOOL;\n    FillingState : INT := 0;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nIF stop THEN\n    FillingState := 0;\nELSIF FillingState = 0 THEN\n    IF start AND NOT LSHH THEN\n        FillingState := 1;\n    END_IF;\nELSIF FillingState <> 1 THEN\n    FillingState := 0;\nEND_IF;\n\n(* Timing begins in the scan that activates the filling step. *)\nFillingTimer(\n    IN := (FillingState = 1),\n    PT := TimerDuration\n);\ntimer_done := FillingTimer.Q;\n\nIF FillingState = 1 THEN\n    IF stop OR LSHH OR timer_done THEN\n        FillingState := 0;\n\n        (* Reset the step-owned timer immediately upon leaving filling. *)\n        FillingTimer(IN := FALSE, PT := TimerDuration);\n        timer_done := FillingTimer.Q;\n    END_IF;\nEND_IF;\n\nfill_valve := (FillingState = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TankController : FB_TimedTankFilling;\n    TimerDuration : TIME := T#10s; (* Configurable filling-time preset. *)\nEND_VAR\n\nTankController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
