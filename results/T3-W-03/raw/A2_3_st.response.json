     "type": "output_text",
     "text": "FUNCTION_BLOCK FB_TimedTankFilling\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    FillingTimer : TON;\n    InterruptionTimer : TOF;\n    ActiveState : INT := 0;\n    start : BOOL;\n    stop : BOOL;\n    x0 : BOOL;\n    x1 : BOOL;\n    x2 : BOOL;\n    ton_q : BOOL;\n    tof_q : BOOL;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nx0 := (ActiveState = 0);\nx1 := (ActiveState = 1);\nx2 := (ActiveState = 2);\n\n(* Both standard timers measure the activity of the filling step. *)\nFillingTimer(IN := x1, PT := TON_Duration);\nInterruptionTimer(IN := x1, PT := TOF_Duration);\n\nton_q := FillingTimer.Q;\ntof_q := InterruptionTimer.Q;\n\nIF stop THEN\n    ActiveState := 0;\nELSE\n    CASE ActiveState OF\n        0:\n            IF start AND NOT LSH THEN\n                ActiveState := 1;\n            END_IF;\n\n        1:\n            IF LSH THEN\n                ActiveState := 0;\n            ELSIF ton_q THEN\n                ActiveState := 2;\n            END_IF;\n\n        2:\n            IF LSH THEN\n                ActiveState := 0;\n            ELSIF NOT tof_q THEN\n                ActiveState := 1;\n            END_IF;\n\n        ELSE\n            ActiveState := 0;\n    END_CASE;\nEND_IF;\n\nx0 := (ActiveState = 0);\nx1 := (ActiveState = 1);\nx2 := (ActiveState = 2);\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\n(* LSHH is an observation only: the specified GRAFCET defines no LSHH transition. *)\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TankController : FB_TimedTankFilling;\n    (* Configurable example presets; tune for the plant. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\nEND_VAR\n\nTankController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := TankController.fill_valve;\nDischargeValve := TankController.discharge_valve;\n\nEND_PROGRAM",
