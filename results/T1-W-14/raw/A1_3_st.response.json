     "text": "FUNCTION_BLOCK TransferRuntime\nVAR_INPUT\n    initialize : BOOL;\n    sensor_a : BOOL;\n    sensor_b : BOOL;\nEND_VAR\nVAR_OUTPUT\n    conveyor : BOOL;\nEND_VAR\nVAR\n    command_latch : RS;\nEND_VAR\n\n(* Initialize G1 to x0: conveyor stopped. *)\nIF initialize THEN\n    command_latch(S := FALSE, R1 := TRUE);\nEND_IF;\n\n(* Reset dominance implements both GRAFCET transitions:\n   x0 -> x1 when sensor_a AND NOT sensor_b;\n   x1 -> x0 when sensor_b. *)\ncommand_latch(\n    S := sensor_a AND NOT sensor_b,\n    R1 := sensor_b\n);\n\nconveyor := command_latch.Q1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    SensorA AT %IX100.0 : BOOL;\n    SensorB AT %IX100.1 : BOOL;\n    Conveyor AT %QX100.0 : BOOL;\nEND_VAR\nVAR\n    runtime_logic : TransferRuntime;\n    first_scan : BOOL := TRUE;\nEND_VAR\n\nruntime_logic(\n    initialize := first_scan,\n    sensor_a := SensorA,\n    sensor_b := SensorB\n);\n\nConveyor := runtime_logic.conveyor;\nfirst_scan := FALSE;\n\nEND_PROGRAM",
