     "type": "output_text",
     "text": "FUNCTION_BLOCK TankRuntime\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TON_Duration : TIME;\n    TOF_Duration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    ActiveState : INT := 0;\n    PreviousState : INT := 0;\n    FillingActive : BOOL;\n    FillTimer : TON;\n    PauseTimer : TOF;\n    ton_q : BOOL;\n    tof_q : BOOL;\nEND_VAR\n\n(* Evaluate both timers cyclically using filling-step activity. *)\nFillingActive := (ActiveState = 1);\nFillTimer(IN := FillingActive, PT := TON_Duration);\nPauseTimer(IN := FillingActive, PT := TOF_Duration);\nton_q := FillTimer.Q;\ntof_q := PauseTimer.Q;\n\nPreviousState := ActiveState;\n\nCASE ActiveState OF\n    0:\n        IF start AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            ActiveState := 1;\n        END_IF;\n\n    1:\n        IF stop OR LSH OR LSHH THEN\n            ActiveState := 0;\n        ELSIF ton_q AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            ActiveState := 2;\n        END_IF;\n\n    2:\n        IF stop OR LSH OR LSHH THEN\n            ActiveState := 0;\n        ELSIF NOT tof_q AND NOT stop AND NOT LSH AND NOT LSHH THEN\n            ActiveState := 1;\n        END_IF;\n\nELSE\n    ActiveState := 0;\nEND_CASE;\n\n(* Synchronize timer inputs immediately when filling activity changes.\n   This starts the TOF delay on departure from the filling step and\n   resets the TON before another filling phase can begin. *)\nIF ActiveState <> PreviousState THEN\n    FillingActive := (ActiveState = 1);\n    FillTimer(IN := FillingActive, PT := TON_Duration);\n    PauseTimer(IN := FillingActive, PT := TOF_Duration);\n    ton_q := FillTimer.Q;\n    tof_q := PauseTimer.Q;\nEND_IF;\n\nfill_valve := (ActiveState = 1);\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable preset values; adjust to the required process timing. *)\n    TON_Duration : TIME := T#5s;\n    TOF_Duration : TIME := T#5s;\n    StartEdge : R_TRIG;\n    start : BOOL;\n    Controller : TankRuntime;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\n\nController(\n    start := start,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TON_Duration := TON_Duration,\n    TOF_Duration := TOF_Duration\n);\n\nFillValve := Controller.fill_valve;\nDischargeValve := Controller.discharge_valve;\n\nEND_PROGRAM",
