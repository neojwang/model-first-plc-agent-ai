     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    state_id : INT := 0;\n    filling_timer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\nIF stop THEN\n    state_id := 0;\nELSE\n    CASE state_id OF\n        0:\n            IF start AND NOT LSHH THEN\n                state_id := 1;\n            END_IF;\n\n        1:\n            IF LSHH THEN\n                state_id := 0;\n            END_IF;\n\n    ELSE\n        state_id := 0;\n    END_CASE;\nEND_IF;\n\nfilling_timer(\n    IN := (state_id = 1) AND NOT stop,\n    PT := TimerDuration\n);\ntimer_done := filling_timer.Q;\n\nIF timer_done THEN\n    state_id := 0;\nEND_IF;\n\nfill_valve := (state_id = 1) AND NOT stop AND NOT LSHH;\ndischarge_valve := FALSE;\n\n(* Reset the timer before accepting a new filling cycle. *)\nIF state_id = 0 THEN\n    filling_timer(IN := FALSE, PT := TimerDuration);\n    timer_done := filling_timer.Q;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    TimerDuration : TIME := T#10s;\n    start_detector : R_TRIG;\n    controller : FillingControl;\nEND_VAR\n\nstart_detector(CLK := StartCommand);\n\ncontroller(\n    start := start_detector.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := controller.fill_valve;\nDischargeValve := controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
