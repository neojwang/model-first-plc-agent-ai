     "text": "FUNCTION_BLOCK FB_TransferRuntime\nVAR_INPUT\n    sensor_a : BOOL;\n    sensor_b : BOOL;\n    initialize : BOOL;\nEND_VAR\nVAR_OUTPUT\n    conveyor : BOOL := FALSE;\nEND_VAR\nVAR\n    run_latch : RS;\nEND_VAR\n\nIF initialize THEN\n    run_latch(S := FALSE, R1 := TRUE);\nEND_IF;\n\nrun_latch(\n    S := sensor_a AND NOT sensor_b,\n    R1 := sensor_b\n);\n\nconveyor := run_latch.Q1;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    sensor_a AT %IX100.0 : BOOL;\n    sensor_b AT %IX100.1 : BOOL;\n    conveyor AT %QX100.0 : BOOL;\nEND_VAR\nVAR\n    runtime : FB_TransferRuntime;\n    first_scan : BOOL := TRUE;\nEND_VAR\n\nruntime(\n    sensor_a := sensor_a,\n    sensor_b := sensor_b,\n    initialize := first_scan\n);\n\nconveyor := runtime.conveyor;\nfirst_scan := FALSE;\n\nEND_PROGRAM",
