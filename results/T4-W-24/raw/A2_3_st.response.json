  {
   "type": "message",
   "id": "msg_09eb378edba3e28b016afa15b53ff887d0a592122d85b9732b",
   "role": "assistant",
   "status": "completed",
   "content": [
    {
     "type": "output_text",
     "text": "FUNCTION_BLOCK LevelControl\nVAR_INPUT\n    StartCommand : BOOL;\n    StopCommand : BOOL;\n    LevelMeter : INT;\n    Kp : REAL := 20.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\n    h_span : REAL := 10.0;\n    t_h : TIME := T#10s;\n    cycle_seconds : REAL := 0.02;\nEND_VAR\nVAR_OUTPUT\n    FillValve : INT;\n    DischargeValve : INT;\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR CONSTANT\n    FULL_SCALE : INT := 1000;\nEND_VAR\nVAR\n    StartEdge : R_TRIG;\n    HoldTimer : TON;\n\n    start : BOOL;\n    stop : BOOL;\n    settled : BOOL;\n    r : INT := 0; (* 0 = LOW, 1 = MID, 2 = HIGH *)\n\n    StateCode : INT := 0;\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n\n    h : REAL;\n    h_sp : REAL;\n    h_target : REAL;\n    h_max : REAL;\n    eps : REAL;\n    error_value : REAL;\n\n    IntegralTerm : REAL := 0.0;\n    CandidateIntegral : REAL;\n    PreviousError : REAL := 0.0;\n    DerivativeRate : REAL;\n    ProportionalDerivative : REAL;\n    CandidateOutput : REAL;\n    RawOutput : REAL;\n    LimitedOutput : REAL;\n    HistoryValid : BOOL := FALSE;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\nstart := StartEdge.Q;\nstop := StopCommand;\n\nh := INT_TO_REAL(LevelMeter) * h_span / INT_TO_REAL(FULL_SCALE);\nh_sp := 0.8 * h_span;\nh_target := h_sp;\nh_max := 0.9 * h_span;\neps := 0.02 * h_span;\nerror_value := h_sp - h;\n\nIF h < h_target THEN\n    r := 0;\nELSIF h < h_max THEN\n    r := 1;\nELSE\n    r := 2;\nEND_IF;\n\nHoldTimer(\n    IN := (StateCode = 1)\n          AND NOT stop\n          AND (r <> 2)\n          AND (ABS(error_value) <= eps),\n    PT := t_h\n);\nsettled := HoldTimer.Q;\n\nIF stop THEN\n    StateCode := 0;\nELSE\n    CASE StateCode OF\n        0:\n            IF start AND (r <> 2) THEN\n                StateCode := 1;\n            END_IF;\n        1:\n            IF settled OR (r = 2) THEN\n                StateCode := 0;\n            END_IF;\n    ELSE\n        StateCode := 0;\n    END_CASE;\nEND_IF;\n\nx0 := StateCode = 0;\nx1 := StateCode = 1;\nfill_valve := x1;\ndischarge_valve := x1;\n\nFillValve := 0;\nDischargeValve := 0;\n\nIF x1 THEN\n    DerivativeRate := 0.0;\n    IF HistoryValid AND (cycle_seconds > 0.0) THEN\n        DerivativeRate :=\n            (error_value - PreviousError) / cycle_seconds;\n    END_IF;\n\n    ProportionalDerivative :=\n        Kp * (error_value + Td * DerivativeRate);\n\n    CandidateIntegral := IntegralTerm;\n    IF (Ti > 0.0) AND (cycle_seconds > 0.0) THEN\n        CandidateIntegral :=\n            IntegralTerm + Kp * error_value * cycle_seconds / Ti;\n    END_IF;\n\n    CandidateOutput := ProportionalDerivative + CandidateIntegral;\n\n    (* Reject integration whenever the proposed output would be clamped. *)\n    IF (CandidateOutput >= 0.0) AND (CandidateOutput <= 100.0) THEN\n        IntegralTerm := CandidateIntegral;\n    END_IF;\n\n    RawOutput := ProportionalDerivative + IntegralTerm;\n\n    IF RawOutput > 100.0 THEN\n        LimitedOutput := 100.0;\n    ELSIF RawOutput < 0.0 THEN\n        LimitedOutput := 0.0;\n    ELSE\n        LimitedOutput := RawOutput;\n    END_IF;\n\n    FillValve :=\n        REAL_TO_INT(LimitedOutput * INT_TO_REAL(FULL_SCALE) / 100.0);\n    DischargeValve :=\n        REAL_TO_INT(0.4 * INT_TO_REAL(FULL_SCALE));\n\n    PreviousError := error_value;\n    HistoryValid := TRUE;\nELSE\n    IntegralTerm := 0.0;\n    PreviousError := error_value;\n    HistoryValid := FALSE;\n    DerivativeRate := 0.0;\n    RawOutput := 0.0;\n    LimitedOutput := 0.0;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LevelMeter AT %IW100 : INT;\n    FillValve AT %QW100 : INT;\n    DischargeValve AT %QW101 : INT;\nEND_VAR\nVAR\n    Controller : LevelControl;\n    Kp : REAL := 20.0;\n    Ti : REAL := 5.0;\n    Td : REAL := 0.0;\n    h_span : REAL := 10.0;\n    t_h : TIME := T#10s;\nEND_VAR\n\nController(\n    StartCommand := StartCommand,\n    StopCommand := StopCommand,\n    LevelMeter := LevelMeter,\n    Kp := Kp,\n    Ti := Ti,\n    Td := Td,\n    h_span := h_span,\n    t_h := t_h,\n    cycle_seconds := 0.02\n);\n\nFillValve := Controller.FillValve;\nDischargeValve := Controller.DischargeValve;\n\nEND_PROGRAM\n\n\nCONFIGURATION Config0\n    RESOURCE Res0 ON PLC\n        TASK ControlTask(INTERVAL := T#20ms, PRIORITY := 0);\n        PROGRAM MainInstance WITH ControlTask : Main;\n    END_RESOURCE\nEND_CONFIGURATION",
