     "type": "output_text",
     "text": "FUNCTION_BLOCK FillingTankControl\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    current_step : INT := 0;\n    filling_timer : TON;\n    timer_done : BOOL := FALSE;\nEND_VAR\n\n(* Stop has priority over starting or continuing a fill. *)\nIF stop THEN\n    current_step := 0;\nELSE\n    CASE current_step OF\n        0:\n            IF start AND NOT LSHH THEN\n                current_step := 1;\n            END_IF;\n\n        1:\n            IF LSHH THEN\n                current_step := 0;\n            END_IF;\n\n        ELSE\n            current_step := 0;\n    END_CASE;\nEND_IF;\n\n(* Timing starts in the same scan that the filling step is entered. *)\nfilling_timer(\n    IN := (current_step = 1),\n    PT := TimerDuration\n);\ntimer_done := filling_timer.Q;\n\nIF (current_step = 1) AND timer_done THEN\n    current_step := 0;\nEND_IF;\n\nfill_valve := (current_step = 1) AND NOT stop AND NOT LSHH;\ndischarge_valve := FALSE;\n\n(* Reset immediately on leaving the filling step, ready for another start. *)\nIF current_step = 0 THEN\n    filling_timer(IN := FALSE, PT := TimerDuration);\nEND_IF;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Adjustable filling duration. *)\n    TimerDuration : TIME := T#10s;\n\n    start : BOOL;\n    stop : BOOL;\n    start_edge : R_TRIG;\n    controller : FillingTankControl;\nEND_VAR\n\nstart_edge(CLK := StartCommand);\nstart := start_edge.Q;\nstop := StopCommand;\n\ncontroller(\n    start := start,\n    stop := stop,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := controller.fill_valve;\nDischargeValve := controller.discharge_valve;\n\nEND_PROGRAM",
     "annotations": [],
     "logprobs": []
    }
