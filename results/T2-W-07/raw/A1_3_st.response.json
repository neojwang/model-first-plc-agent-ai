     "text": "FUNCTION_BLOCK FB_TimedFilling\nVAR_INPUT\n    start : BOOL;\n    stop : BOOL;\n    LSH : BOOL;\n    LSHH : BOOL;\n    TimerDuration : TIME;\nEND_VAR\nVAR_OUTPUT\n    fill_valve : BOOL;\n    discharge_valve : BOOL;\nEND_VAR\nVAR\n    x0 : BOOL := TRUE;\n    x1 : BOOL := FALSE;\n    timer_done : BOOL := FALSE;\n    FillingTimer : TON;\nEND_VAR\n\nFillingTimer(IN := x1, PT := TimerDuration);\ntimer_done := FillingTimer.Q;\n\nIF x1 THEN\n    IF stop OR LSHH OR timer_done THEN\n        x1 := FALSE;\n        x0 := TRUE;\n\n        FillingTimer(IN := FALSE, PT := TimerDuration);\n        timer_done := FALSE;\n    END_IF;\nELSIF x0 THEN\n    IF start AND NOT stop AND NOT LSHH THEN\n        x0 := FALSE;\n        x1 := TRUE;\n\n        FillingTimer(IN := TRUE, PT := TimerDuration);\n        timer_done := FALSE;\n    END_IF;\nEND_IF;\n\nfill_valve := x1;\ndischarge_valve := FALSE;\n\nEND_FUNCTION_BLOCK\n\n\nPROGRAM Main\nVAR\n    StartCommand AT %IX100.0 : BOOL;\n    StopCommand AT %IX100.1 : BOOL;\n    LSH AT %IX100.2 : BOOL;\n    LSHH AT %IX100.3 : BOOL;\n\n    FillValve AT %QX100.0 : BOOL;\n    DischargeValve AT %QX100.1 : BOOL;\nEND_VAR\nVAR\n    (* Configurable filling duration; adjust for the application. *)\n    TimerDuration : TIME := T#10s;\n    StartEdge : R_TRIG;\n    FillingControl : FB_TimedFilling;\nEND_VAR\n\nStartEdge(CLK := StartCommand);\n\nFillingControl(\n    start := StartEdge.Q,\n    stop := StopCommand,\n    LSH := LSH,\n    LSHH := LSHH,\n    TimerDuration := TimerDuration\n);\n\nFillValve := FillingControl.fill_valve;\nDischargeValve := FillingControl.discharge_valve;\n\nEND_PROGRAM",
