  next(x4) := s15_x4;
  next(x5) := s15_x5;
  next(x6) := s15_x6;
  next(x10) := s15_x10;
  next(x11) := s15_x11;
-- P1: overfill: after h >= h_max is observed, the fill valve is closed in the next stable situation
SPEC AG (r = HIGH -> AX !fill_valve)
-- P2: stop: StopCommand forces G1 to {0} with the fill valve closed in the next stable situation
SPEC AG (stop -> AX (x0 & !fill_valve))
-- P3: an open fill valve can be closed again while StopCommand stays false
SPEC AG ((fill_valve & !stop) -> E [ !stop U !fill_valve ])
-- P4: step 0 can be reached from every reachable situation while StopCommand stays false
SPEC AG (!stop -> E [ !stop U x0 ])
-- W1: well-formedness: steps 21 and 22 are exclusive
SPEC AG (!(x21 & x22))
-- W2: well-formedness: AND-branches 5 and 6 are active together
SPEC AG (x5 <-> x6)
-- W3: well-formedness: macro-steps are mutually exclusive
SPEC AG (!((xE1 | xS1) & (xE2 | x21 | x22 | xS2 | xE3 | xS3)) & !((xE2 | x21 | x22 | xS2) & (xE3 | xS3)))
-- W4: well-formedness: G1 is never empty
SPEC AG (x0 | xE1 | xS1 | xE2 | x21 | x22 | xS2 | xE3 | xS3 | x4 | x5 | x6)
-- W5: well-formedness: every evolution reaches a stable situation (no never-ending transient cycle)
SPEC AG stable
